---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
// ELIMINADO: Se quita la importación de pages-index.css de aquí.
// Este archivo contiene estilos específicos para la página de inicio y no debe ser global.
// Se carga directamente en `src/pages/index.astro`.

interface Props {
	title: string;
	description?: string;
	image?: string;
	favicon?: string;
}

const { 
	title, 
	description = "DomiVolt - Servicios eléctricos domiciliarios profesionales en Monteagudo. Emergencias 24/7 e instalaciones nuevas y modernas, mantenimiento preventivo y correctivo.",
	image = "/logodomivolt.png",
	favicon = "/logodomivolt.png"
} = Astro.props;

// Aseguramos que la imagen tenga una URL absoluta para que las redes sociales la muestren correctamente
const socialImageURL = new URL(image, Astro.url);
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={Astro.url} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <title>{title}</title>
    <!-- Favicon Multi-navegador -->
    <link rel="icon" type="image/png" href={favicon} />
    <link rel="shortcut icon" href={favicon} type="image/png" />
    <link rel="apple-touch-icon" href={favicon} />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    
    <!-- MD3 Fonts & Icons -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0" />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800&family=Barlow:wght@400;600;700&display=swap" rel="stylesheet" />
    <ClientRouter />
</head>
<body> 
    <a href="#main-content" class="skip-link">Saltar al contenido principal</a>
    <!-- Efecto de Rayos Global (Pure CSS) -->
    <div class="storm-effect">
        <div class="lightning l1"></div>
        <div class="lightning l2"></div>
        <div class="flash"></div>
    </div>
    
    <main id="main-content">
        <slot />
    </main>
    
    <!-- WhatsApp Float Button -->
    <a href="https://wa.me/59167671818?text=Hola%20DomiVolt,%20necesito%20información" 
       class="whatsapp-float" 
       target="_blank"
       rel="noopener noreferrer"
       title="Contactar por WhatsApp"
       aria-label="Contactar por WhatsApp">
            <i class="fab fa-whatsapp"></i>    
    </a>

    <script src="/js/main.js" is:inline></script>
</body>
</html>

<style is:global>
    /*
     * ELIMINADO: Se ha quitado el bloque de variables de tema de este archivo.
     * La única fuente de verdad para las variables de color ahora es /src/styles/global.css.
     * Esto resuelve el conflicto que impedía que los fondos y tarjetas cambiaran de color.
     */

    /* Estilos para el enlace "Saltar al contenido" */
    .skip-link {
        position: absolute;
        top: -40px; /* Oculto fuera de la pantalla */
        left: 0;
        background: var(--brand-orange);
        color: #000;
        padding: 10px 15px;
        z-index: 9999;
        transition: top 0.3s ease;
        font-weight: bold;
        border-bottom-right-radius: 8px;
    }

    .skip-link:focus {
        top: 0; /* Se hace visible al recibir foco */
        outline: none; /* El estilo ya es suficiente indicación de foco */
    }


    /*
     * NOTA: Los estilos de .container, .btn, .btn-primary, .btn-secondary,
     * .storm-effect, .whatsapp-float, el reset y las variables viven ahora
     * ÚNICAMENTE en /src/styles/global.css (única fuente de verdad).
     * Se eliminaron de aquí para evitar cascadas impredecibles y referencias
     * a variables inexistentes (--font-condensed).
     */
</style>