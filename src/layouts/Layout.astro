---
interface Props {
	title: string;
	description?: string;
	image?: string;
	favicon?: string;
}

const { 
	title, 
	description = "DomiVolt - Servicios eléctricos profesionales en Monteagudo. Emergencias 24/7 e instalaciones para domicilios y empresas.",
	image = "/assets/images/logodomivolt.png",
	favicon = "/assets/images/logo.png"
} = Astro.props;

// Aseguramos que la imagen tenga una URL absoluta para que las redes sociales la muestren correctamente
const socialImageURL = new URL(image, Astro.url);
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={Astro.url} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <title>{title}</title>
    <link rel="icon" type="image/png" href={favicon} />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>
<body>
    <!-- Efecto de Rayos Global (Pure CSS) -->
    <div class="storm-effect">
        <div class="lightning l1"></div>
        <div class="lightning l2"></div>
        <div class="flash"></div>
    </div>

    <slot />
    
    <!-- WhatsApp Float Button -->
    <a href="https://wa.me/59178491525?text=Hola%20DomiVolt,%20necesito%20información" 
       class="whatsapp-float" 
       target="_blank"
       rel="noopener noreferrer"
       title="Contactar por WhatsApp"
       aria-label="Contactar por WhatsApp">
            <i class="fab fa-whatsapp"></i>    
    </a>

    <script src="/js/main.js" is:inline></script>
</body>
</html>

<style is:global>
    :root {
        --primary: #013C58;
        --secondary: #00537A;
        --accent: #F5A201;
        --accent-light: #FFD35B;
        --text-light: #A8E8F9;
        --text-dark: #333;
        --white: #ffffff;
        --bg-light: #f8f9fa;
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        line-height: 1.6;
        color: var(--text-dark);
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .section-title {
        text-align: center;
        font-size: 2.5rem;
        color: var(--primary);
        margin-bottom: 50px;
    }

    /* Buttons */
    .btn {
        padding: 15px 35px;
        font-size: 1.1rem;
        border: none;
        border-radius: 50px;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s ease;
        font-weight: bold;
    }

    .btn-primary {
        background: linear-gradient(135deg, var(--accent) 0%, #FFBA42 100%);
        color: var(--primary);
        box-shadow: 0 4px 15px rgba(245, 162, 1, 0.4);
    }

    .btn-primary:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 20px rgba(245, 162, 1, 0.6);
    }

    .btn-secondary {
        background: transparent;
        color: white;
        border: 2px solid var(--accent-light);
    }

    .btn-secondary:hover {
        background: var(--accent-light);
        color: var(--primary);
        transform: translateY(-3px);
    }

    /* WhatsApp Float */
    .whatsapp-float {
        position: fixed;
        bottom: 30px;
        right: 30px;
        background: #25D366;
        color: white;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.3);
        cursor: pointer;
        text-decoration: none;
        transition: all 0.3s ease;
        z-index: 999;
    }

    .whatsapp-float:hover {
        transform: scale(1.1);
        box-shadow: 0 6px 20px rgba(0,0,0,0.4);
    }

    /* --- ANIMACIÓN DE RAYOS (Pure CSS) --- */
    .storm-effect {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none; /* IMPORTANTE: Permite hacer clic en los botones debajo */
        z-index: 50; /* Encima de los fondos, debajo del menú */
        mix-blend-mode: screen; /* Se fusiona con tus gradientes (negro se vuelve transparente) */
        overflow: hidden;
    }

    .lightning {
        position: absolute;
        top: -50px;
        width: 100px;
        height: 120vh;
        background: #fff;
        opacity: 0;
        /* Forma más fina y afilada */
        clip-path: polygon(48% 0%, 52% 0%, 50% 35%, 60% 35%, 48% 55%, 58% 55%, 45% 100%, 55% 55%, 45% 55%, 55% 35%, 45% 35%);
        /* Doble resplandor: uno cian intenso y otro azul profundo para dar volumen */
        filter: drop-shadow(0 0 10px #00eaff) drop-shadow(0 0 25px #0077be);
    }

    .l1 {
        left: 15%;
        animation: strike 5s infinite;
    }

    .l2 {
        right: 15%;
        animation: strike 7s infinite 2s;
        transform: scaleX(-1); /* Invertimos el rayo para que se vea diferente */
    }

    /* Destello ambiental sutil */
    .flash {
        position: absolute;
        inset: 0;
        background: white;
        opacity: 0;
        animation: ambient-flash 7s infinite;
    }

    @keyframes strike {
        0% { opacity: 0; }
        90% { opacity: 0; }
        91% { opacity: 1; filter: brightness(2); } /* Destello inicial cegador */
        92% { opacity: 0; }
        93% { opacity: 0.8; } /* Réplica fuerte */
        94% { opacity: 0; }
        96% { opacity: 0.5; } /* Último chisporroteo */
        100% { opacity: 0; }
    }

    @keyframes ambient-flash {
        0%, 92% { opacity: 0; }
        93% { opacity: 0.05; } /* Ilumina muy suavemente toda la pantalla */
        94% { opacity: 0; }
    }
</style>