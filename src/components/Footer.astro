---
const currentYear = new Date().getFullYear();
---

<footer>
    <div class="container">
        <div class="footer-content">
            <div class="brand-section">
                <span class="footer-logo">DomiVolt</span>
                <p>Ingeniería y seguridad eléctrica en Monteagudo.</p>
                <div class="law-badge">
                    <span class="material-symbols-rounded">verified_user</span>
                    Diagnóstico Ley 2026
                </div>
            </div>

            <nav class="footer-links" aria-label="Enlaces rápidos">
                <a href="/#soluciones">Servicios</a>
                <a href="/tecnicos">Expertos</a>
                <a href="/#contacto">Presupuesto</a>
            </nav>
            
            <div class="social-section">
                <a href="https://wa.me/59167671818" target="_blank" aria-label="WhatsApp"><i class="fab fa-whatsapp"></i></a>
                <a href="https://facebook.com" target="_blank" aria-label="Facebook"><i class="fab fa-facebook"></i></a>
                <a href="mailto:info@domivolt.com" aria-label="Email"><i class="fas fa-envelope"></i></a>
            </div>
        </div>
        
        <div class="copyright-section">
            <p>&copy; {currentYear} DomiVolt. Todos los derechos reservados.</p>
        </div>
    </div>
</footer>

<style>
    footer {
        background: #000000;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        padding: 50px 0 20px;
        color: var(--md-on-surface);
        margin-top: 80px;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .footer-content {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding-bottom: 30px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        margin-bottom: 20px;
        gap: 40px;
    }

    .footer-logo {
        font-size: 28px;
        font-weight: 800;
        color: var(--accent);
        text-shadow: 0 0 15px rgba(252, 163, 17, 0.3);
        display: block;
        margin-bottom: 5px;
    }

    .brand-section p {
        color: var(--md-on-surface-variant);
        font-size: 0.95rem;
        margin: 0;
    }

    .law-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.75rem;
        color: var(--accent);
        background: rgba(254, 104, 2, 0.1);
        padding: 5px 12px;
        border-radius: var(--shape-sm, 4px);
        margin-top: 15px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .law-badge .material-symbols-rounded { font-size: 16px; }

    .footer-links {
        display: flex;
        gap: 25px;
    }

    .footer-links a {
        color: var(--md-on-surface-variant);
        text-decoration: none;
        font-size: 0.95rem;
        transition: color 0.3s ease;
    }

    .footer-links a:hover {
        color: var(--accent);
    }

    .social-section {
        display: flex;
        gap: 20px;
    }

    .social-section a {
        color: var(--md-on-surface);
        font-size: 24px;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 45px;
        height: 45px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.05);
    }

    .social-section a:hover {
        background: var(--accent);
        color: var(--md-on-primary, #000);
        transform: translateY(-3px);
    }

    .copyright-section {
        text-align: center;
        font-size: 0.9rem;
        color: var(--md-on-surface-variant);
    }

    @media (max-width: 768px) {
        .footer-content {
            flex-direction: column;
            text-align: center;
            align-items: center;
            gap: 30px;
        }
        .brand-section {
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .social-section {
            justify-content: center;
            width: 100%;
        }
        .footer-links {
            justify-content: center;
            flex-wrap: wrap;
            width: 100%;
        }
    }
</style>