---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Servicios y Proceso - DomiVolt" description="Conoce nuestro proceso de trabajo, áreas de cobertura y servicios eléctricos detallados.">
    <header>
        <nav>
            <div class="logo-container">
            <img src="/src/assets/logodomivolt.png" alt="logo">
            <a href="/" class="logo">DomiVolt</a>
            </div>
            <button class="hamburger" aria-label="Menú de navegación">
                <div class="line"></div>
                <div class="line"></div>
                <div class="line"></div>
            </button>
            <ul class="nav-links">
                <li><a href="/">Inicio</a></li>
                <li><a href="/servicios" style="color: var(--accent);">Servicios</a></li>
                <li><a href="/tecnicos">Tecnico</a></li>
                <li><a href="/#contacto">Contacto</a></li>
            </ul>
        </nav>
    </header>

    <section class="page-header">
        <div class="container">
            <h1>Nuestros <span class="highlight">Servicios</span></h1>
            <p>Soluciones técnicas integrales con estándares de seguridad industrial.</p>
        </div>
    </section>

    <!-- SECCIÓN DE SERVICIOS (Movida desde index) -->
    <section class="services">
        <div class="container">
            <div class="services-grid">
                <div class="service-card">
                    <div class="service-icon">🔌</div>
                    <h3>Instalaciones Eléctricas</h3>
                    <p>Instalación completa de sistemas eléctricos residenciales, comerciales e industriales con garantía certificada.</p>
                </div>
                <div class="service-card">
                    <div class="service-icon">🔧</div>
                    <h3>Mantenimiento Preventivo</h3>
                    <p>Revisiones periódicas para garantizar el funcionamiento óptimo y seguro de tus instalaciones eléctricas.</p>
                </div>
                <div class="service-card">
                    <div class="service-icon">⚠️</div>
                    <h3>Emergencias 24/7</h3>
                    <p>Servicio de urgencias disponible todos los días del año. Respuesta rápida ante cualquier falla eléctrica.</p>
                </div>
                <div class="service-card">
                    <div class="service-icon">💡</div>
                    <h3>Iluminación LED</h3>
                    <p>Actualización a sistemas de iluminación LED eficientes que reducen hasta un 80% el consumo eléctrico.</p>
                </div>
                <div class="service-card">
                    <div class="service-icon">🏠</div>
                    <h3>Automatización</h3>
                    <p>Instalación de sistemas domóticos para control inteligente de iluminación, climatización y seguridad.</p>
                </div>
                <div class="service-card">
                    <div class="service-icon">📊</div>
                    <h3>Certificaciones</h3>
                    <p>Emisión de certificados eléctricos y boletines oficiales cumpliendo toda la normativa vigente.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- SECCIÓN GALERÍA (Nueva) -->
    <section class="gallery" id="proyectos">
        <div class="container">
            <h2>Trabajos <span class="highlight">Realizados</span></h2>
            <p style="text-align: center; margin-bottom: 40px; color: #ccc; font-size: 18px;">Calidad y precisión en cada instalación.</p>
            <div class="gallery-grid">
                <div class="gallery-item">
                    <img src="/tablero.png" alt="Instalación de Tableros">
                    <div class="gallery-info">
                        <h3>Tableros Industriales</h3>
                        <p>Montaje y peinado de cables certificado.</p>
                    </div>
                </div>
                <div class="gallery-item">
                    <img src="/iluminacionled.webp" alt="Iluminación LED">
                    <div class="gallery-info">
                        <h3>Iluminación LED</h3>
                        <p>Proyectos de eficiencia energética.</p>
                    </div>
                </div>
                <div class="gallery-item">
                    <img src="/cableado.jpg" alt="Instalación Domiciliaria">
                    <div class="gallery-info">
                        <h3>Residencial</h3>
                        <p>Cableado seguro para viviendas nuevas.</p>
                    </div>
                </div>
                <div class="gallery-item">
                    <img src="/mantenimiento.webp" alt="Mantenimiento">
                    <div class="gallery-info">
                        <h3>Mantenimiento</h3>
                        <p>Diagnóstico y reparación de fallas.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- SECCIÓN PROCESO (Movida desde index) -->
    <section class="process" id="proceso">
        <div class="container">
            <h2>Nuestro <span class="highlight">Proceso</span></h2>
            <div class="process-steps">
                <div class="step">
                    <div class="step-number">01</div>
                    <h3>Contacto</h3>
                    <p>Diagnóstico inicial gratis vía WhatsApp o visita técnica.</p>
                </div>
                <div class="step">
                    <div class="step-number">02</div>
                    <h3>Presupuesto</h3>
                    <p>Cotización detallada sin compromiso y transparente.</p>
                </div>
                <div class="step">
                    <div class="step-number">03</div>
                    <h3>Ejecución</h3>
                    <p>Instalación técnica con materiales certificados.</p>
                </div>
                <div class="step">
                    <div class="step-number">04</div>
                    <h3>Garantía</h3>
                    <p>Pruebas de seguridad y entrega de garantía por escrito.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- SECCIÓN PAZ MENTAL (Movida desde index) -->
    <section class="peace-of-mind">
        <div class="container">
            <h2>Tu <span class="highlight">Tranquilidad</span></h2>
            <div class="pom-grid">
                <div class="pom-card">
                    <div class="pom-icon">⏱️</div>
                    <h3>Puntualidad</h3>
                    <p>Respetamos tu tiempo. Llegamos a la hora acordada.</p>
                </div>
                <div class="pom-card">
                    <div class="pom-icon">✨</div>
                    <h3>Limpieza</h3>
                    <p>Usamos protectores y dejamos todo impecable al terminar.</p>
                </div>
                <div class="pom-card">
                    <div class="pom-icon">🛡️</div>
                    <h3>Seguridad</h3>
                    <p>Cumplimiento estricto de normativa NB 777 y seguridad eléctrica.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- SECCIÓN COBERTURA (Movida desde index) -->
    <section class="coverage" id="cobertura">
        <div class="container">
            <h2>Áreas de <span class="highlight">Cobertura</span></h2>
            <div class="coverage-grid">
                <div class="coverage-card active">
                    <h3>📍 Monteagudo</h3>
                    <p>Atención inmediata disponible</p>
                    <span class="badge">✓ Activo Ahora</span>
                </div>
                <div class="coverage-card coming-soon">
                    <h3> 📍 Muyupampa</h3>
                    <p>Próxima expansión</p>
                    <span class="badge">Próximamente</span>
                </div>
                <div class="coverage-card coming-soon">
                    <h3> 📍 Camiri</h3>
                    <p>Próxima expansión</p>
                    <span class="badge">Próximamente</span>
                </div>
                <div class="coverage-card coming-soon">
                    <h3>📍 Santa Cruz</h3>
                    <p>Próxima expansión</p>
                    <span class="badge">Próximamente</span>
                </div>
                <div class="coverage-card coming-soon">
                    <h3> 📍 Padilla</h3>
                    <p>Proxima expansión</p>
                    <span class="badge">Próximamente</span>
                </div>
                <div class="coverage-card coming-soon">
                    <h3>📍 Sucre</h3>
                    <p>Próxima expansión</p>
                    <span class="badge">Próximamente</span>
                </div>
            </div>
        </div>
    </section>

    <footer>
        <p>&copy; 2025 DomiVolt. Todos los derechos reservados. | Servicios Eléctricos Profesionales</p>
    </footer>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const hamburger = document.querySelector('.hamburger');
            const navLinks = document.querySelector('.nav-links');
            
            hamburger.addEventListener('click', () => {
                navLinks.classList.toggle('open');
                hamburger.classList.toggle('toggle');
            });
        });
    </script>

    <style>
        /* Estilos Base copiados de index.astro para consistencia */
        :global(body) { 
            font-family: 'Segoe UI', sans-serif; 
            background: #000000; 
            color: #E5E5E5; 
            overflow-x: hidden; 
        }
        .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }
        .highlight { color: #FCA311; text-shadow: 0 0 30px rgba(252, 163, 17, 0.6); }
        h2 { font-size: 42px; text-align: center; margin-bottom: 60px; color: #FFFFFF; }

        /* Header */
        header { background: linear-gradient(135deg, var(--primary) 0%, #000000 100%); padding: 20px 0; position: fixed; width: 100%; top: 0; z-index: 1000; box-shadow: 0 4px 20px rgba(252, 163, 17, 0.2); }
        nav { max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; padding: 0 20px; }
        .logo-container { display: flex; align-items: center; }
        .logo-container img { width: 70px; margin-right: 10px; }
        .logo { font-size: 28px; font-weight: bold; color: var(--accent); text-decoration: none; }
        .nav-links { display: flex; gap: 30px; list-style: none; }
        .nav-links a { color: #E5E5E5; text-decoration: none; font-weight: 500; }
        .nav-links a:hover { color: var(--accent); }
        .hamburger { display: none; cursor: pointer; background: none; border: none; padding: 10px; }
        .line { width: 25px; height: 3px; background-color: #E5E5E5; margin: 5px; transition: all 0.3s; }

        /* Page Header (Hero pequeño) */
        .page-header {
            padding: 150px 20px 60px;
            background: linear-gradient(135deg, #000000 0%, #14213D 100%);
            text-align: center;
        }
        .page-header h1 { font-size: 48px; color: white; margin-bottom: 20px; }
        .page-header p { font-size: 20px; color: #ccc; }

        /* Servicios Grid */
        .services { padding: 60px 20px; background: #14213D; }
        .services-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 30px; }
        .service-card { background: linear-gradient(135deg, #000000 0%, #14213D 100%); padding: 40px 30px; border-radius: 20px; text-align: center; border: 2px solid transparent; transition: all 0.3s; }
        .service-card:hover { transform: translateY(-10px); border-color: #FCA311; }
        .service-icon { font-size: 60px; margin-bottom: 20px; }
        .service-card h3 { font-size: 24px; margin-bottom: 15px; color: #FCA311; }
        
        /* Estilos para la lista de problemas */
        .service-card ul {
            text-align: left;
            list-style: none;
            padding: 15px;
            background: rgba(0, 0, 0, 0.2);
            border-radius: 10px;
            margin-top: 10px;
        }
        .service-card li {
            position: relative;
            padding-left: 25px;
            margin-bottom: 8px;
            color: #ccc;
            font-size: 15px;
        }
        .service-card li::before {
            content: "⚡";
            position: absolute;
            left: 0;
            color: #FCA311;
        }

        /* Galería */
        .gallery { padding: 100px 20px; background: #000000; }
        .gallery-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; }
        .gallery-item { position: relative; border-radius: 15px; overflow: hidden; border: 1px solid #333; aspect-ratio: 4/3; }
        .gallery-item img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
        .gallery-item:hover img { transform: scale(1.1); }
        .gallery-info { 
            position: absolute; 
            bottom: 0; 
            left: 0; 
            width: 100%; 
            background: rgba(20, 33, 61, 0.95); 
            padding: 20px; 
            border-top: 2px solid #FCA311;
            transform: translateY(100%);
            transition: transform 0.3s ease;
        }
        .gallery-item:hover .gallery-info { transform: translateY(0); }
        /* En móviles mostramos la info siempre para mejor UX */
        @media (max-width: 768px) {
            .gallery-info { transform: translateY(0); padding: 15px; }
        }
        .gallery-info h3 { color: #FCA311; font-size: 18px; margin-bottom: 5px; }
        .gallery-info p { color: #E5E5E5; font-size: 14px; margin: 0; }

        /* Proceso */
        .process { padding: 100px 20px; background: #14213D; } /* Cambiado para alternar */
        .process-steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 30px; margin-top: 50px; }
        .step { padding: 20px; text-align: center; }
        .step-number { font-size: 40px; font-weight: 900; color: rgba(252, 163, 17, 0.2); margin-bottom: 10px; }
        .step h3 { color: #FCA311; margin-bottom: 10px; font-size: 20px; }

        /* Paz Mental */
        .peace-of-mind { padding: 100px 20px; background: #000000; } /* Cambiado para alternar */
        .pom-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 40px; text-align: center; }
        .pom-card { padding: 30px; background: rgba(255, 255, 255, 0.05); border-radius: 15px; border: 1px solid #333; transition: transform 0.3s; }
        .pom-card:hover { transform: translateY(-5px); border-color: #FCA311; }
        .pom-icon { font-size: 40px; margin-bottom: 20px; }
        .pom-card h3 { color: #FFFFFF; margin-bottom: 10px; }

        /* Cobertura */
        .coverage { padding: 100px 20px; background: #14213D; } /* Cambiado para alternar */
        .coverage-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 30px; justify-content: center; }
        .coverage-card { background: linear-gradient(135deg, #000000 0%, #14213D 100%); padding: 30px; border-radius: 15px; text-align: center; border: 1px solid #333; }
        .coverage-card.active { border-color: #FCA311; box-shadow: 0 0 15px rgba(252, 163, 17, 0.2); }
        .coverage-card h3 { color: #FFFFFF; margin-bottom: 10px; font-size: 22px; }
        .badge { display: inline-block; padding: 5px 12px; border-radius: 20px; font-size: 14px; font-weight: bold; }
        .active .badge { background: rgba(252, 163, 17, 0.2); color: #FCA311; }
        .coming-soon .badge { background: rgba(255, 255, 255, 0.1); color: #999; }

        footer { background: #000000; padding: 30px 20px; text-align: center; color: #E5E5E5; border-top: 2px solid #14213D; }

        @media (max-width: 768px) {
            .hamburger { display: block; z-index: 1001; }
            .nav-links { position: fixed; background: #000000; height: 100vh; width: 100%; top: 0; left: 0; flex-direction: column; align-items: center; justify-content: center; transform: translateX(100%); transition: transform 0.3s ease-in-out; z-index: 1000; }
            .nav-links.open { transform: translateX(0%); }
            .page-header { padding-top: 120px; }
        }
    </style>
</Layout>