    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const btnSend = document.getElementById('btnSend');
            if (btnSend) {
                btnSend.addEventListener('click', () => {
                    const nombre = (document.getElementById('fName') as HTMLInputElement).value;
                    const telefono = (document.getElementById('fPhone') as HTMLInputElement).value;
                    const servicio = (document.getElementById('fService') as HTMLSelectElement).value;
                    const mensaje = (document.getElementById('fMsg') as HTMLTextAreaElement).value;

                    if(!nombre || !telefono) {
                        alert("Por favor, completa tu nombre y teléfono.");
                        return;
                    }
                    
                    const text = `*SOLICITUD WEB DOMIVOLT*\n\n*Nombre:* ${nombre}\n*Tel:* ${telefono}\n*Servicio:* ${servicio}\n*Mensaje:* ${mensaje}`;
                    window.open(`https://wa.me/59167671818?text=${encodeURIComponent(text)}`, '_blank');

                    // Cambiar estado a éxito
                    btnSend.classList.add('success');
                    btnSend.innerHTML = '<span class="material-symbols-rounded">check_circle</span> ¡Solicitud Enviada!';
                });
            }

            // Lógica de Scroll Reveal
            const observerOptions = {
                threshold: 0.15
            };

            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('active');
                    }
                });
            }, observerOptions);

            document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

            // ── Lógica de Máquina de Escribir (Typewriter) ──
            const typewriterEl = document.querySelector('.typewriter');
            if (typewriterEl) {
                const words = JSON.parse(typewriterEl.getAttribute('data-words') || '[]');
                let wordIndex = 0;
                let charIndex = words[0].length;
                let isDeleting = true;
                let speed = 150;

                function type() {
                    const currentWord = words[wordIndex];
                    
                    if (isDeleting) {
                        typewriterEl.textContent = currentWord.substring(0, charIndex - 1);
                        charIndex--;
                        speed = 80; // Velocidad al borrar
                    } else {
                        typewriterEl.textContent = currentWord.substring(0, charIndex + 1);
                        charIndex++;
                        speed = 150; // Velocidad al escribir
                    }

                    if (!isDeleting && charIndex === currentWord.length) {
                        isDeleting = true;
                        speed = 2000; // Pausa cuando la palabra está completa
                    } else if (isDeleting && charIndex === 0) {
                        isDeleting = false;
                        wordIndex = (wordIndex + 1) % words.length;
                        speed = 500; // Pausa antes de empezar nueva palabra
                    }

                    setTimeout(type, speed);
                }
                
                // Iniciamos la animación después de un pequeño delay
                setTimeout(type, 1500);
            }

            // ── Lógica de Brillo (Spotlight) ──
            window.addEventListener('mousemove', (e) => {
                const { clientX, clientY } = e;
                document.documentElement.style.setProperty('--mouse-x', `${clientX}px`);
                document.documentElement.style.setProperty('--mouse-y', `${clientY}px`);
            });

            // ── Lógica de Sonido Eléctrico (Sintetizado) ──
            let audioCtx;
            function playElectricZap() {
                if (!audioCtx) {
                    audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
                }
                if (audioCtx.state === 'suspended') audioCtx.resume();

                // Crear buffer de ruido blanco para la estática
                const bufferSize = audioCtx.sampleRate * 0.05; // 50ms (muy corto)
                const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
                const data = buffer.getChannelData(0);
                for (let i = 0; i < bufferSize; i++) {
                    data[i] = Math.random() * 2 - 1;
                }

                const noise = audioCtx.createBufferSource();
                noise.buffer = buffer;
                const filter = audioCtx.createBiquadFilter();
                filter.type = 'bandpass';
                filter.frequency.value = 1800; // Frecuencia técnica
                const gain = audioCtx.createGain();
                gain.gain.setValueAtTime(0.02, audioCtx.currentTime); // Muy suave
                gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.05);
                noise.connect(filter).connect(gain).connect(audioCtx.destination);
                noise.start();
            }

            // Asignar el sonido a todos los botones principales
            const buttons = document.querySelectorAll('.cta-button, .cta-secondary, .btn-tonal, .form-submit-btn, .contact-tile');
            buttons.forEach(btn => btn.addEventListener('click', playElectricZap));
        });
    </script>
</Layout>

<style>
    /* Estilos globales para esta página */
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
        scroll-padding-top: 100px; /* Evita que el header tape los títulos al navegar */
        overflow-x: hidden;
        /* Efecto de cuadrícula de cuaderno */
        background-color: #000;
        background-image:
            radial-gradient(600px circle at var(--mouse-x, -1000px) var(--mouse-y, -1000px), rgba(252, 163, 17, 0.12), transparent 80%),
            linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
        background-size: 100% 100%, 30px 30px, 30px 30px;
        background-attachment: fixed, scroll, scroll;
    }

    body {
        overflow-x: hidden;
    }

    .hero {
        /* Imagen de fondo (Asegúrate de tener esta imagen en tu carpeta public) */
