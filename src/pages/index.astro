---
// src/pages/index.astro
// Esta es ahora tu Landing Page principal
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

// Importamos los nuevos componentes
import SectionTitle from "../components/SectionTitle.astro";
import ServiceCard from "../components/ServiceCard.astro";
import FaqItem from "../components/FaqItem.astro";

// 1. Importa los estilos específicos de la página.
import "../styles/pages-index.css";
---

<Layout
    title="DomiVolt: Electricista Profesional en Monteagudo | Emergencias 24/7"
    description="Domivolt ofrece servicios de electricista en Monteagudo - Chuquisaca. Instalaciones eléctricas, reparación de cortocircuitos y mantenimiento domiciliario profesional."
>
    <Header />
    <section class="hero">
        <div class="container hero-container section-grid-bg">
            <div class="hero-content">
                <h1>Servicios Eléctricos 
                    <span aria-live="polite"><span class="highlight typewriter" data-words='["Sostenibles", "Profesionales", "Seguros", "Garantizados"]'>Sostenibles</span></span> para tu Hogar
                </h1>
                <div class="hero-badges">
                    <span class="badge emergency-badge">⚡ Emergencias 24/7</span>
                    <span class="badge service-badge tertiary-badge">🌱 Energía Solar y Ahorro</span>
                </div>
                
                <a
                    href="https://wa.me/59167671818?text=Hola%20DomiVolt,%20quisiera%20solicitar%20un%20presupuesto%20gratis"
                    class="btn btn-primary cta-button btn-icon"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <span class="material-symbols-rounded">chat</span>
                    <span>Solicitar Presupuesto Gratis</span>
                </a>
            </div>
        </div>
    </section>

    <section class="services" id="servicios-electricos">
        <div class="container">
            <SectionTitle 
                title="Soluciones Eléctricas Profesionales"
                subtitle="Ingeniería y precisión aplicadas a instalaciones residenciales y comerciales."
                highlight="Eléctricas" />
            <div class="services-grid">
                <ServiceCard 
                    icon="electrical_services"
                    title="Instalaciones Eléctricas"
                    description="Instalaciones eléctricas para hogares y negocios, aplicando los más altos estándares de seguridad y calidad.">
                    <a href="#contacto-domivolt" class="btn btn-secondary">Saber más</a>
                </ServiceCard>
                <ServiceCard 
                    icon="build"
                    title="Mantenimiento Preventivo"
                    description="Revisiones periódicas para garantizar el funcionamiento óptimo y seguro de tus instalaciones eléctricas.">
                    <a href="#contacto-domivolt" class="btn btn-secondary">Saber más</a>
                </ServiceCard>
                <ServiceCard 
                    icon="bolt"
                    title="Emergencias 24/7"
                    description="Servicio de urgencias disponible todos los días del año. Respuesta rápida ante cualquier falla eléctrica.">
                    <a href="#contacto-domivolt" class="btn btn-secondary">Saber más</a>
                </ServiceCard>
            </div>
            <div class="services-action">
                <a href="#servicios-especializados" class="btn btn-primary">Ver Servicios Especializados</a>
            </div>
        </div>
    </section>

    <!-- SECCIÓN DE SERVICIOS ESPECIALIZADOS (COMPLEMENTARIOS) -->
    <section class="complementary-services section-grid-bg" id="servicios-especializados">
        <div class="container">
            <SectionTitle 
                title="Servicios Especializados"
                subtitle="Tecnología avanzada para modernizar y proteger tu espacio."
                highlight="Especializados" />
            <div class="comp-grid">
                <ServiceCard 
                    icon="videocam"
                    title="Cámaras de Seguridad"
                    description="Sistemas de vigilancia IP y análogas con monitoreo remoto desde tu celular."
                    variant="compact"
                />
                <ServiceCard 
                    icon="lan"
                    title="Redes y Fibra Óptica"
                    description="Instalación de puntos de red, cableado estructurado y fusión de fibra."
                    variant="compact"
                />
                <ServiceCard 
                    icon="satellite_alt"
                    title="Internet Starlink"
                    description="Instalación profesional y configuración de kits satelitales en campo o ciudad."
                    variant="compact"
                />
                <ServiceCard 
                    icon="solar_power"
                    title="Energía Solar y Autoconsumo"
                    description="Produce tu propia electricidad, vende lo que te sobre a la red y reduce tu factura hasta un 80%."
                    variant="compact"
                />
            </div>
        </div>
    </section>

    <!-- SECCIÓN DE MODERNIZACIÓN LEY 2026 -->
    <section class="modernization reveal" id="modernizacion-ley-2026">
      <div class="container">
        <div class="modern-grid">
          <div class="modern-info">
            <div class="section-label">
              <span class="material-symbols-rounded">upgrade</span>
              Tecnología y Eficiencia
            </div>
            <h2>Moderniza tu hogar bajo la <br><span class="highlight">Nueva Ley 2026</span></h2>
            <p class="modern-lead">La normativa boliviana actual no es solo un trámite, es la puerta de entrada a una vivienda autónoma, segura y de bajo costo operativo.</p>
            
            <ul class="modern-list">
              <li>
                <span class="material-symbols-rounded">eco</span>
                <div>
                  <strong>Produce tu propia Energía</strong>
                  <p>Instala paneles solares para tu consumo y vende el excedente a la red eléctrica automáticamente.</p>
                </div>
              </li>
              <li>
                <span class="material-symbols-rounded">ev_station</span>
                <div>
                  <strong>Infraestructura de Electromovilidad</strong>
                  <p>Instalamos circuitos dedicados para carga de vehículos eléctricos bajo estándares internacionales.</p>
                </div>
              </li>
              <li>
                <span class="material-symbols-rounded">verified_user</span>
                <div>
                  <strong>Certificación y Seguridad</strong>
                  <p>Actualizamos tu tablero y sistemas de protección para cumplir con las nuevas exigencias legales.</p>
                </div>
              </li>
            </ul>

            <div class="modern-action">
              <!-- Se ha añadido un span para el texto y la clase 'justify-center' -->
              <a href="#contacto-domivolt" class="btn btn-accent justify-center">
                <span>Consultar Plan de Modernización</span>
                <span class="material-symbols-rounded">arrow_forward</span>
              </a>
            </div>
          </div>

          <div class="modern-visual">
            <div class="saving-card">
              <div class="chart-header">
                <span class="material-symbols-rounded">analytics</span>
                <span>Proyección de Ahorro Mensual</span>
              </div>
              <div class="bar-group">
                <div class="bar-item">
                  <div class="bar-meta"><span>Gasto Actual</span> <strong>100%</strong></div>
                  <div class="bar-container"><div class="bar bar-current"></div></div>
                </div>
                <div class="bar-item">
                  <div class="bar-meta"><span>Con Energía Solar</span> <strong>20%</strong></div>
                  <div class="bar-container"><div class="bar bar-modernized"></div></div>
                </div>
              </div>
              <p class="chart-note">Basado en optimización técnica y sistemas de autoconsumo.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECCIÓN DE COMPROMISO TÉCNICO -->
    <section class="commitment reveal">
        <div class="container commitment-grid">
            <div class="card commitment-card">
                <div class="commitment-icon">🛡️</div>
                <div class="commitment-text">
                    <h3>Seguridad <span class="highlight">Garantizada</span></h3>
                    <p>Aplicamos rigor de ingeniería para proteger lo más importante: tu familia y tu patrimonio en cada conexión.</p>
                </div>
            </div>
            <div class="card commitment-card">
                <div class="commitment-icon">🏆</div>
                <div class="commitment-text">
                    <h3>Excelencia <span class="highlight">Técnica</span></h3>
                    <p>Referente de confianza e innovación en Monteagudo, aplicando estándares de precisión en cada proyecto.</p>
                </div>
            </div>
        </div>
        <div class="commitment-quote">
            <p>"La seguridad no es negociable, la excelencia es nuestra norma." — <strong>Casimiro Oropeza</strong></p>
        </div>
    </section>

    <section class="features reveal" id="nuestra-experiencia">
        <div class="container">
            <h2 class="section-title">Respaldo y <span class="highlight">Autoridad Técnica</span></h2>
            <div class="features-grid">
                <div class="feature-item">
                    <div class="feature-number">5+</div>
                    <div class="feature-text">Años de Trayectoria Técnica</div>
                </div>
                <div class="feature-item">
                    <div class="feature-number">200+</div>
                    <div class="feature-text">Servicios Garantizados</div>
                </div>
                <div class="feature-item">
                    <div class="feature-number">100%</div>
                    <div class="feature-text">Seguridad Certificada</div>
                </div>
                <div class="feature-item">
                    <div class="feature-number">24/7</div>
                    <div class="feature-text">Respuesta Inmediata</div>
                </div>
            </div>
            <div class="features-action">
                <p>Liderados por el Técnico Casimiro Oropeza, nuestro equipo aplica estándares de precisión industrial en cada hogar.</p>
                <a href="/expertos" class="btn btn-secondary">Conocer al Fundador y Equipo</a>
            </div>
        </div>
    </section>

    <section class="faq section-grid-bg" id="preguntas-frecuentes">
        <div class="container">
            <SectionTitle title="Preguntas Frecuentes" highlight="Frecuentes" />
            <div class="faq-grid">
                <FaqItem question="¿Cuánto cuesta un electricista en Monteagudo?">
                    El costo depende de la complejidad del trabajo. Sin embargo, en DomiVolt ofrecemos <strong>presupuestos gratuitos</strong> y sin compromiso. Contáctanos por WhatsApp o llámanos para evaluar tu caso y darte un precio justo.
                </FaqItem>
                <FaqItem question="¿Cuándo debo cambiar un tablero eléctrico?">
                    Se recomienda cambiarlo si tiene más de 20 años, si usa fusibles antiguos, si escuchas zumbidos, si los interruptores saltan frecuentemente o si notas olor a quemado. Un tablero moderno es vital para la seguridad de tu hogar.
                </FaqItem>
                <FaqItem question="¿Qué hacer si hay un cortocircuito?">
                    Primero, mantén la calma y baja la llave general o el breaker principal. Desconecta los aparatos afectados y no intentes repararlo tú mismo si no tienes experiencia. Llámanos de inmediato a nuestro servicio de <strong>Emergencias 24/7</strong>.
                </FaqItem>
                <FaqItem question="¿Qué métodos de pago aceptan?">
                    Para tu comodidad, aceptamos pagos en <strong>efectivo, transferencias bancarias y pagos por QR</strong>. Emitimos recibo o factura según lo necesites.
                </FaqItem>
                <FaqItem question="¿Ofrecen garantía por sus trabajos?">
                    Sí, absolutamente. Todos nuestros servicios cuentan con <strong>garantía de satisfacción</strong>. Si surge algún inconveniente relacionado con nuestra instalación, lo solucionamos sin costo adicional.
                </FaqItem>
                <FaqItem question="¿Cómo me beneficia la nueva Ley de Energías Renovables?">
                    La nueva normativa de <strong>Generación Distribuida</strong> permite que instales paneles solares en tu casa o negocio y te conviertas en "prosumidor". Esto significa que puedes consumir tu propia energía y, si te sobra, el sistema la inyecta a la red pública, dándote un crédito a favor en tu factura mensual de luz.
                </FaqItem>
                <FaqItem question="¿Realizan trabajos pequeños?">
                    ¡Claro que sí! Ningún trabajo es demasiado pequeño. Desde cambiar un tomacorriente o una ducha hasta instalaciones completas, estamos listos para ayudarte.
                </FaqItem>
            </div>
        </div>
    </section>

    <!-- SECCIÓN DE TESTIMONIOS -->
    <section class="testimonials">
        <div class="container">
            <h2 class="section-title">Lo que dicen nuestros <span class="highlight">Clientes</span></h2>
            <div class="testimonial-grid">
                <div class="card testimonial-card">
                    <div class="stars">★★★★★</div>
                    <p>"Excelente servicio. Repararon un cortocircuito en mi negocio en tiempo récord. Muy profesionales y limpios al trabajar."</p>
                    <div class="client-info">
                        <img src="https://i.pravatar.cc/150?u=juan" alt="Juan Pérez" class="client-photo" />
                        <div>
                            <strong>Juan Pérez</strong>
                            <span>Propietario de Negocio</span>
                        </div>
                    </div>
                </div>
                <div class="card testimonial-card">
                    <div class="stars">★★★★★</div>
                    <p>"La instalación de las cámaras de seguridad quedó perfecta. El técnico Casimiro explicó todo el funcionamiento detalladamente."</p>
                    <div class="client-info">
                        <img src="https://i.pravatar.cc/150?u=maria" alt="Mario Lopez" class="client-photo" />
                        <div>
                            <strong>Mario Lopez</strong>
                            <span>Residente Monteagudo</span>
                        </div>
                    </div>
                </div>
                <div class="card testimonial-card">
                    <div class="stars">★★★★★</div>
                    <p>"Muy puntuales y honestos con el presupuesto. Los recomiendo totalmente para cualquier trabajo eléctrico en el hogar."</p>
                    <div class="client-info">
                        <img src="https://i.pravatar.cc/150?u=carlos" alt="Martha Perez" class="client-photo" />
                        <div>
                            <strong>Martha Perez</strong>
                            <span>Cliente Hogar</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CONTACTO PROFESIONAL -->
    <section class="contact-section section-grid-bg" id="contacto-domivolt">
      <div class="container">
        <div class="contact-layout">
          <div class="contact-copy">
            <div class="section-label">
              <span class="material-symbols-rounded">contact_support</span>
              Contacto Directo
            </div>
            <h2 class="section-h2">¿Problema <em class="highlight">Eléctrico</em>?<br><span>Estamos Aquí.</span></h2>
            <p class="section-desc">Cuéntanos tu problema o solicita una revisión técnica bajo la nueva normativa de seguridad. Respondemos en tiempo récord.</p>
       
            <div class="contact-ways">
              <a href="https://wa.me/59167671818" target="_blank" class="card contact-tile vibrate-tile">
                <div class="contact-tile-icon"><span class="material-symbols-rounded">chat</span></div>
                <div><span class="tile-label">WhatsApp Inmediato</span><span class="tile-value">+591 67671818</span></div>
              </a>
              <a href="tel:+59167671818" class="card contact-tile">
                <div class="contact-tile-icon"><span class="material-symbols-rounded">call</span></div>
                <div><span class="tile-label">Llamar Ahora</span><span class="tile-value">+591 67671818</span></div>
              </a>
              <div class="card contact-tile">
                <div class="contact-tile-icon"><span class="material-symbols-rounded">location_on</span></div>
                <div><span class="tile-label">Zona de Cobertura</span><span class="tile-value">Monteagudo – Bolivia</span></div>
              </div>
              <div class="card contact-tile">
                <div class="contact-tile-icon"><span class="material-symbols-rounded">alarm</span></div>
                <div><span class="tile-label">Disponibilidad</span><span class="tile-value">24/7 · Emergencias</span></div>
              </div>
            </div>
          </div>
       
          <div class="contact-form-pro">
            <div class="form-hint reveal">
              <span class="material-symbols-rounded">info</span>
              Presupuesto gratis y sin compromiso →
            </div>
       
            <div class="field-wrap reveal">
              <label class="field-label">Tu Nombre</label>
              <input type="text" id="fName" placeholder="Ej. Juan Pérez" required aria-describedby="name-error">
              <div id="name-error" class="error-message">Este campo es obligatorio.</div>
            </div>
       
            <div class="field-wrap reveal">
              <label class="field-label">Teléfono o WhatsApp</label>
              <input type="tel" id="fPhone" placeholder="+591 XXX XXXXX" required aria-describedby="phone-error">
              <div id="phone-error" class="error-message">Este campo es obligatorio.</div>
            </div>
       
            <div class="field-wrap reveal">
              <label class="field-label">Tipo de Servicio</label>
              <select id="fService">
                <option value="">Selecciona un servicio…</option>
                <option>Emergencia eléctrica urgente</option>
                <option>Instalación eléctrica nueva</option>
                <option>Mantenimiento preventivo</option>
                <option>Diagnóstico normativa 2026</option>
                <option>Actualización de tablero / cableado</option>
                <option>Instalación para paneles solares</option>
                <option>Otro</option>
              </select>
            </div>
       
            <div class="field-wrap reveal">
              <label class="field-label">¿Qué necesitas?</label>
              <textarea id="fMsg" placeholder="Cuéntanos brevemente tu problema..."></textarea>
            </div>
       
            <button class="form-submit-btn reveal" id="btnSend">
              <span class="material-symbols-rounded">send</span>
              Solicitar Presupuesto Gratis
            </button>
          </div>
        </div>

        <div class="map-container">
            <iframe 
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d15026.867277977824!2d-63.9545634!3d-19.8080564!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x93f1a63055555555%3A0xf026607623329666!2sMonteagudo%2C%20Bolivia!5e0!3m2!1ses-419!2sbo" 
                width="100%" 
                height="350" 
                style="border:0;" 
                allowfullscreen="" 
                loading="lazy">
            </iframe>
        </div>
      </div>
    </section>

    <Footer />

    <script>
        // 3. Eliminamos el script duplicado. La lógica ahora vive en /public/js/main.js
        // y se carga a través del Layout.
        // Si necesitas lógica específica para esta página, puedes añadirla aquí.
    </script>
</Layout>

<!-- 4. Eliminamos la etiqueta <style> gigante. Todos los estilos ahora vienen de los archivos CSS importados. -->
