        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }

    .hero::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        /* Gradiente más denso basado en el color primario para mejor contraste */
        background: linear-gradient(180deg, 
            rgba(2, 20, 42, 0.4) 0%, 
            rgba(2, 20, 42, 0.7) 50%, 
            rgba(2, 20, 42, 0.9) 100%
        );
        z-index: 1;
    }

    .hero-container {
        position: relative;
        z-index: 2;
        text-align: center;
        width: 100%;
        max-width: 900px;
    }

    .hero-content {
        margin: 0 auto;
    }

    h1 {
        font-size: clamp(2.5rem, 8vw, 4rem);
        margin-bottom: 20px;
        color: var(--md-on-surface);
        line-height: 1.2;
        font-weight: 800;
        text-transform: uppercase;
        text-shadow: 0 4px 15px rgba(0, 0, 0, 0.8);
    }

    /* Estilos del cursor para Typewriter */
    .typewriter::after {
        content: '|';
        animation: blink 0.8s infinite;
        margin-left: 2px;
        color: var(--accent);
    }

    @keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0; }
    }

    .highlight {
        color: var(--accent);
        text-shadow: 0 0 30px rgba(252, 163, 17, 0.6);
    }

    .hero-badges {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 15px;
        margin-bottom: 40px;
    }

    .hero-badges span {
        font-size: 18px;
        padding: 10px 25px;
        border-radius: 50px;
        display: inline-flex;
        align-items: center;
        font-weight: bold;
    }

    .emergency-badge {
        background-color: #d90429; /* Rojo intenso para alerta */
        color: #ffffff !important; /* Forzamos blanco */
        box-shadow: 0 0 20px rgba(217, 4, 41, 0.6);
        animation: pulse-badge 2s infinite;
    }

    .service-badge {
        background-color: rgba(255, 255, 255, 0.15);
        color: #ffffff !important;
        backdrop-filter: blur(5px);
        border: 1px solid rgba(255, 255, 255, 0.3);
    }

    .tertiary-badge {
        border-color: var(--md-tertiary) !important;
        background-color: color-mix(in srgb, var(--md-tertiary) 20%, transparent) !important;
        color: var(--white) !important;
    }

    @keyframes pulse-badge {
        0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(217, 4, 41, 0.7); }
        70% { transform: scale(1.05); box-shadow: 0 0 0 10px rgba(217, 4, 41, 0); }
        100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(217, 4, 41, 0); }
    }

    .hero span {
        color: var(--accent);
    }

    .cta-button {
        display: inline-block;
        background: linear-gradient(135deg, var(--accent) 0%, #e09510 100%);
        color: #000000;
        padding: 18px 45px;
        text-decoration: none;
        border-radius: 50px;
        font-weight: 800;
        font-size: 18px;
        transition: all 0.3s;
        box-shadow: 0 10px 30px rgba(252, 163, 17, 0.4);
    }

    .cta-button:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 40px rgba(252, 163, 17, 0.6);
    }

    .cta-secondary {
        display: inline-block;
        padding: 12px 30px;
        border: 2px solid var(--accent);
        color: var(--accent);
        text-decoration: none;
        border-radius: 50px;
        font-weight: 700;
        transition: all 0.3s;
    }

    .cta-secondary:hover {
        background: var(--accent);
        color: #000;
    }

    .services {
        padding: 100px 20px;
        background-color: var(--primary);
        background-image:
            radial-gradient(600px circle at var(--mouse-x, -1000px) var(--mouse-y, -1000px), rgba(252, 163, 17, 0.12), transparent 80%),
            linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
        background-size: 100% 100%, 30px 30px, 30px 30px;
        background-attachment: fixed, scroll, scroll;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
    }

    h2 {
        font-size: clamp(2rem, 5vw, 2.8rem);
        text-align: center;
        margin-bottom: 60px;
        color: var(--md-on-surface);
        font-weight: 700;
        text-transform: uppercase;
    }

    .services-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
        gap: 30px;
    }

    .service-card {
        background: var(--md-surface-container);
        padding: 48px 32px;
        border-radius: var(--shape-xl);
        text-align: center;
        transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
        border: 1px solid var(--md-outline-variant);
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
    }

    .service-card:hover {
        transform: translateY(-8px);
        border-color: var(--md-primary);
        box-shadow: var(--elev-2);
    }

    .service-icon-wrap {
        width: 72px;
        height: 72px;
        background: rgba(254, 104, 2, 0.1);
        border-radius: var(--shape-lg);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
    }

    .service-icon-wrap .material-symbols-rounded {
        font-size: 36px;
        color: var(--md-primary);
    }

    .service-card h3 {
        font-size: 24px;
        margin-bottom: 15px;
        color: var(--accent);
        font-weight: 700;
    }

    .service-card p {
        color: var(--md-on-surface-variant);
    }

    /* Servicios Especializados (Complementarios) */
    .complementary-services {
        padding: 80px 20px;
        background-color: #000000;
        background-image:
            radial-gradient(600px circle at var(--mouse-x, -1000px) var(--mouse-y, -1000px), rgba(252, 163, 17, 0.12), transparent 80%),
            linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
        background-size: 100% 100%, 30px 30px, 30px 30px;
        background-attachment: fixed, scroll, scroll;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
    }

    .comp-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 25px;
        max-width: 1100px;
        margin: 0 auto;
    }

    .comp-card {
        background: var(--md-surface-container);
        padding: 48px 32px;
        border-radius: var(--shape-xl);
        text-align: center;
        transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
        border: 1px solid var(--md-outline-variant);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
    }

    .comp-card:hover {
        transform: translateY(-8px);
        border-color: var(--md-primary);
        box-shadow: var(--elev-2);
    }

    .comp-card h3 {
        color: var(--accent);
        font-size: 1.2rem;
        margin-bottom: 10px;
    }

    .comp-card p {
        color: var(--md-on-surface-variant);
        font-size: 0.95rem;
        line-height: 1.4;
    }

    /* --- MODERNIZATION SECTION --- */
    .modernization {
        padding: 120px 20px;
        background: #000;
        position: relative;
    }

    .modern-grid {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 80px;
        align-items: center;
    }

    .modern-lead {
        font-size: 1.2rem;
        color: var(--md-on-surface-variant);
        margin-bottom: 40px;
        line-height: 1.6;
    }

    .modern-list {
        list-style: none;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 32px;
    }

    .modern-list li {
        display: flex;
        gap: 20px;
        align-items: flex-start;
    }

    .modern-list li .material-symbols-rounded {
        color: var(--md-tertiary);
        background: color-mix(in srgb, var(--md-tertiary) 15%, transparent);
        padding: 12px;
        border-radius: 16px;
        font-size: 28px;
        animation: pulse-tertiary 4s infinite;
    }

    @keyframes pulse-tertiary {
        0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--md-tertiary) 40%, transparent); }
        70% { box-shadow: 0 0 0 15px color-mix(in srgb, var(--md-tertiary) 0%, transparent); }
        100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--md-tertiary) 0%, transparent); }
    }

    .modern-list li strong {
        display: block;
        color: var(--md-on-surface);
        font-size: 1.15rem;
        margin-bottom: 4px;
    }

    .modern-list li p {
        color: var(--md-on-surface-variant);
        font-size: 0.95rem;
        margin: 0;
        line-height: 1.5;
    }

    .modern-action {
        margin-top: 50px;
    }

    .saving-card {
        background: var(--md-surface-container);
        padding: 40px;
        border-radius: 32px;
        border: 1px solid var(--md-outline-variant);
        box-shadow: 0 20px 50px rgba(0,0,0,0.5);
    }

    .bar-item {
        margin-bottom: 28px;
    }

    .bar-meta {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
        font-size: 0.9rem;
        color: var(--md-on-surface-variant);
    }

    .bar-meta strong { color: var(--md-on-surface); }

    .bar-container {
        height: 16px;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 6px;
        overflow: hidden;
    }

    .bar {
        height: 100%;
        width: 0; /* Inicia en 0 para que la transición se dispare */
        border-radius: inherit;
        transition: width 1.5s cubic-bezier(0.34, 1.56, 0.64, 1);
        display: block;
    }

    /* Valores finales cuando la sección entra en pantalla */
    .active .bar-current { width: 100%; }
    .active .bar-modernized { width: 20%; }

    .bar-current { background: #555; }
    .bar-modernized { 
        background: linear-gradient(90deg, var(--md-tertiary), #00e676);
        box-shadow: 0 0 15px rgba(0, 189, 104, 0.3);
    }

    .chart-note {
        font-size: 0.75rem !important;
        opacity: 0.6;
        margin-top: 12px !important;
        font-style: italic;
    }

    .btn-tonal {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        background: var(--accent);
        color: #000;
        padding: 16px 32px;
        border-radius: var(--shape-lg);
        text-decoration: none;
        font-weight: 800;
        font-family: 'Barlow Condensed', sans-serif;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 4px 15px rgba(254, 104, 2, 0.3);
    }

    .btn-tonal:hover {
        background: var(--white);
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(254, 104, 2, 0.5);
    }

    .ley-action {
        flex-shrink: 0;
    }

    /* Compromiso Técnico (Compacto) */
    .commitment {
        padding: 60px 20px;
        background: linear-gradient(180deg, #000000 0%, var(--primary) 100%);
        border-top: 1px solid rgba(252, 163, 17, 0.1);
    }

    .commitment-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
        gap: 30px;
        max-width: 1000px;
        margin: 0 auto 30px auto;
    }

    .commitment-card {
        background: rgba(255, 255, 255, 0.02);
        padding: 25px;
        border-radius: 15px;
        border: 1px solid rgba(255, 255, 255, 0.05);
        display: flex;
        align-items: center;
        gap: 20px;
        transition: transform 0.3s ease;
    }

    .commitment-card:hover {
        background: rgba(255, 255, 255, 0.04);
        border-color: rgba(252, 163, 17, 0.5);
        box-shadow: 0 0 20px rgba(252, 163, 17, 0.1);
    }

    .commitment-icon {
        font-size: 35px;
        filter: drop-shadow(0 0 10px rgba(252, 163, 17, 0.3));
        transition: all 0.3s ease;
    }

    .commitment-card:hover .commitment-icon {
        filter: drop-shadow(0 0 20px rgba(252, 163, 17, 0.8));
        transform: scale(1.15);
    }

    .commitment-text h3 {
        font-size: 1.3rem;
        margin-bottom: 5px;
        color: var(--md-on-surface);
    }

    .commitment-text p {
        color: var(--md-on-surface-variant);
        line-height: 1.4;
        font-size: 0.9rem;
    }

    .commitment-quote {
        text-align: center;
        color: var(--accent);
        font-style: italic;
        font-size: 1rem;
        opacity: 0.8;
    }

    /* Animación Scroll Reveal */
    .reveal {
        opacity: 0;
        transform: translateY(50px);
        transition: opacity 1.2s cubic-bezier(0.5, 0, 0, 1), transform 1.2s cubic-bezier(0.5, 0, 0, 1);
    }

    .reveal.active {
        opacity: 1;
        transform: translateY(0);
    }

    .features {
        padding: 100px 20px;
        background-color: #000000;
        background-image:
            radial-gradient(600px circle at var(--mouse-x, -1000px) var(--mouse-y, -1000px), rgba(252, 163, 17, 0.12), transparent 80%),
            linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
        background-size: 100% 100%, 30px 30px, 30px 30px;
        background-attachment: fixed, scroll, scroll;
    }

    .features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 40px;
        margin-top: 60px;
    }

    .feature-item {
        text-align: center;
    }

    .feature-number {
        font-size: 48px;
        font-weight: bold;
        color: var(--accent);
        margin-bottom: 10px;
        text-shadow: 0 0 20px rgba(252, 163, 17, 0.5);
    }

    .feature-text {
        color: var(--md-on-surface);
        font-size: 18px;
    }

    /* --- FAQ SECTION --- */
    .faq {
        padding: 100px 20px;
        background:
            radial-gradient(600px circle at var(--mouse-x, -1000px) var(--mouse-y, -1000px), rgba(252, 163, 17, 0.12), transparent 80%),
            linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
            linear-gradient(180deg, #000000 0%, var(--primary) 100%);
        background-size: 100% 100%, 30px 30px, 30px 30px, 100% 100%;
        background-attachment: fixed, scroll, scroll, scroll;
    }

    .faq-grid {
        max-width: 800px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .faq-item {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 15px;
        overflow: hidden;
        transition: all 0.3s ease;
    }

    .faq-item[open] {
        border-color: var(--accent);
        background: rgba(0, 0, 0, 0.2);
    }

    summary {
        padding: 20px;
        cursor: pointer;
        font-weight: bold;
        font-size: 18px;
        color: var(--md-on-surface);
        list-style: none; /* Oculta el triángulo por defecto */
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    summary::-webkit-details-marker {
        display: none; /* Para Chrome/Safari */
    }

    summary::after {
        content: '+';
        font-size: 24px;
        content: '\25BC'; /* Código Unicode para flecha hacia abajo (▼) */
        font-size: 20px;
        color: var(--accent);
        font-weight: bold;
        transition: transform 0.3s;
    }

    details[open] summary::after {
        transform: rotate(45deg); /* Convierte el + en una x */
        transform: rotate(180deg); /* Gira la flecha hacia arriba */
    }

    .faq-item p {
        padding: 0 20px 25px 20px;
        color: var(--md-on-surface-variant);
        line-height: 1.6;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        margin-top: 0;
        padding-top: 15px;
    }

    /* --- TESTIMONIALS SECTION --- */
    .testimonials {
        padding: 100px 20px;
        background-color: var(--primary);
        background-image:
            radial-gradient(600px circle at var(--mouse-x, -1000px) var(--mouse-y, -1000px), rgba(252, 163, 17, 0.12), transparent 80%),
            linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
        background-size: 100% 100%, 30px 30px, 30px 30px;
        background-attachment: fixed, scroll, scroll;
    }

    .testimonial-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 30px;
        margin-top: 40px;
    }

    .testimonial-card {
        background: rgba(255, 255, 255, 0.03);
        padding: 40px;
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.05);
        transition: transform 0.3s ease;
    }

    .testimonial-card:hover {
        transform: translateY(-5px);
        border-color: var(--accent);
    }

    .stars {
        color: var(--accent);
        font-size: 20px;
        margin-bottom: 15px;
    }

    .testimonial-card p {
        color: var(--md-on-surface);
        font-style: italic;
        line-height: 1.6;
        margin-bottom: 20px;
    }

    .client-info {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .client-photo {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid var(--accent);
        box-shadow: 0 0 15px rgba(252, 163, 17, 0.2);
    }

    .client-info strong {
        display: block;
        color: var(--md-on-surface);
        font-size: 18px;
    }

    .client-info span {
        color: var(--accent);
        font-size: 14px;
    }

    /* ── CONTACT SECTION (M3) ── */
    .section-alt {
        padding: 100px 20px;
        background-color: var(--primary);
        background-image:
            radial-gradient(600px circle at var(--mouse-x, -1000px) var(--mouse-y, -1000px), rgba(252, 163, 17, 0.12), transparent 80%),
            linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
        background-size: 100% 100%, 30px 30px, 30px 30px;
        background-attachment: fixed, scroll, scroll;
    }

    .contact-layout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 48px;
        align-items: start;
        margin-top: 40px;
    }

    .section-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--accent);
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.1em;
        margin-bottom: 12px;
    }

    .section-h2 {
        font-size: 3rem;
        line-height: 1.1;
        margin-bottom: 20px;
        text-align: left;
        color: var(--md-on-surface);
    }

    .section-h2 span {
        color: var(--md-on-surface);
        opacity: 0.7;
    }

    .section-desc {
        color: var(--md-on-surface-variant);
        font-size: 1.1rem;
        max-width: 500px;
        margin-bottom: 30px;
    }

    .contact-ways { display: flex; flex-direction: column; gap: 12px; margin-top: 28px; }

    /* M3 List Tile */
    .contact-tile {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 16px 20px;
        background: var(--md-surface-container);
        border: 1px solid var(--md-outline-variant);
        border-radius: var(--shape-lg);
        text-decoration: none;
        transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
    }
    .contact-tile:hover { 
        border-color: var(--md-primary); 
        box-shadow: var(--elev-2);
        transform: translateX(5px);
    }

    .contact-tile-icon {
        width: 44px; height: 44px;
        background: rgba(254, 104, 2, 0.1); /* Basado en var(--accent) */
        border-radius: var(--shape-md);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .contact-tile-icon .material-symbols-rounded { color: var(--md-primary); font-size: 22px; }

    .tile-label { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--md-on-surface-variant); display: block; }
    .tile-value { font-family: 'Barlow Condensed', sans-serif; font-weight: 700; font-size: 1.05rem; letter-spacing: 0.04em; color: var(--md-on-surface); display: block; margin-top: 1px; }

    /* ── FORM (M3 Outlined TextField) ── */
    .contact-form-pro {
        background: var(--md-surface-container);
        border: 1px solid var(--md-outline-variant);
        border-radius: var(--shape-xl);
        padding: 32px;
        box-shadow: var(--elev-2);
        position: relative;
        overflow: hidden;
    }

    .contact-form-pro::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 4px;
        background: linear-gradient(90deg, var(--md-primary), var(--md-secondary));
    }

    .form-hint {
        display: flex;
        align-items: center;
        gap: 8px;
        background: rgba(138,217,246,0.08);
        border: 1px solid rgba(138,217,246,0.2);
        border-radius: var(--shape-md);
        padding: 10px 14px;
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--md-secondary);
        margin-bottom: 24px;
        letter-spacing: 0.03em;
    }
    .form-hint .material-symbols-rounded { font-size: 18px; }

    .field-wrap {
        position: relative;
        margin-bottom: 16px;
    }

    .field-label {
        display: block;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--md-on-surface-variant);
        margin-bottom: 6px;
    }

    .field-wrap input,
    .field-wrap textarea,
    .field-wrap select {
