---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="DomiVolt - Servicios Eléctricos 24/7 | Monteagudo">
    <Header />

    <main>
        <!-- Hero Section -->
        <section class="hero" aria-labelledby="hero-title">
            <div class="hero-content">
                <img src="/assets/images/logo.png" alt="logotipo DomiVolt">
                <h1 id="hero-title">DomiVolt</h1>
                <p>Servicios Eléctricos Profesionales para tu Hogar y Negocio</p>
                <p style="font-size: 1.1rem; margin-top: -15px;">⚡ Emergencias 24/7 | 🔧 Instalaciones Profesionales</p>
                <div class="cta-buttons">
                    <a href="https://wa.me/59178491525?text=Hola%20DomiVolt,%20necesito%20un%20servicio%20eléctrico" class="btn btn-primary">Solicitar Servicio</a>
                    <a href="#contacto" class="btn btn-secondary">Más Información</a>
                </div>
            </div>
        </section>

        <!-- Services Section -->
        <section id="servicios" class="services" aria-labelledby="services-title">
            <div class="container">
                <h2 id="services-title" class="section-title">Nuestros Servicios</h2>
                <div class="services-grid">
                    <article class="service-card">
                        <div class="service-icon">🚨</div>
                        <h3>Emergencias 24/7</h3>
                        <p>Atención inmediata para problemas eléctricos urgentes.</p>
                        <ul class="service-list">
                            <li>Cortos circuitos</li>
                            <li>Apagones repentinos</li>
                            <li>Fallas en instalaciones</li>
                            <li>Problemas de seguridad eléctrica</li>
                        </ul>
                        <span class="service-schedule">Disponible 24/7</span>
                    </article>

                    <article class="service-card">
                        <div class="service-icon">🔌</div>
                        <h3>Instalaciones Nuevas</h3>
                        <p>Instalaciones eléctricas completas y profesionales.</p>
                        <ul class="service-list">
                            <li>Instalaciones residenciales</li>
                            <li>Oficinas y negocios</li>
                            <li>Iluminación LED</li>
                            <li>Puntos de electricidad</li>
                        </ul>
                        <span class="service-schedule">Lunes a Viernes</span>
                    </article>

                    <article class="service-card">
                        <div class="service-icon">🔧</div>
                        <h3>Mantenimiento y Reparación</h3>
                        <p>Mantenimiento preventivo y correctivo de sistemas eléctricos.</p>
                        <ul class="service-list">
                            <li>Revisión de tableros</li>
                            <li>Reparación de averías</li>
                            <li>Actualización de sistemas</li>
                            <li>Certificaciones eléctricas</li>
                        </ul>
                        <span class="service-schedule">Lunes a Viernes</span>
                    </article>

                    <article class="service-card">
                        <div class="service-icon">🏢</div>
                        <h3>Pequeñas Empresas</h3>
                        <p>Servicios especializados para instituciones y negocios.</p>
                        <ul class="service-list">
                            <li>Oficinas</li>
                            <li>Comercios</li>
                            <li>Instituciones educativas</li>
                            <li>Locales comerciales</li>
                        </ul>
                        <span class="service-schedule">Presupuestos personalizados</span>
                    </article>
                    
                    <article class="service-card">
                        <div class="service-icon">🏠</div>
                        <h3>Domótica</h3>
                        <p>Instalaciones inteligentes para hogares y negocios.</p>
                        <ul class="service-list">
                            <li>Control de iluminación</li>
                            <li>Control de temperatura</li>
                            <li>Ahorro de energía</li>
                            <li>Seguridad inteligente</li>
                        </ul>
                        <span class="service-schedule">Presupuestos personalizados</span>
                    </article>
                </div>
            </div>
        </section>

        <!-- Why Choose Us -->
        <aside class="why-choose" aria-labelledby="why-title">
            <div class="container">
                <h2 id="why-title">¿Por Qué Elegir DomiVolt?</h2>
                <div class="benefits-grid">
                    <div class="benefit-item">
                        <div class="benefit-icon">⚡</div>
                        <h3>Respuesta Rápida</h3>
                        <p>Atención inmediata en emergencias las 24 horas del día</p>
                    </div>
                    <div class="benefit-item">
                        <div class="benefit-icon">👨‍🔧</div>
                        <h3>Profesionales Certificados</h3>
                        <p>Técnicos capacitados y con experiencia comprobada</p>
                    </div>
                    <div class="benefit-item">
                        <div class="benefit-icon">💰</div>
                        <h3>Precios Justos</h3>
                        <p>Presupuestos transparentes sin costos ocultos</p>
                    </div>
                    <div class="benefit-item">
                        <div class="benefit-icon">✅</div>
                        <h3>Garantía de Servicio</h3>
                        <p>Todos nuestros trabajos están garantizados</p>
                    </div>
                </div>
            </div>
        </aside>

        <!-- Coverage Section -->
        <section id="cobertura" class="coverage" aria-labelledby="coverage-title">
            <div class="container">
                <h2 id="coverage-title" class="section-title">Áreas de Cobertura</h2>
                <div class="coverage-grid">
                    <article class="coverage-card active">
                        <h3>📍 Monteagudo</h3>
                        <p>Atención inmediata disponible</p>
                        <span class="badge">✓ Activo Ahora</span>
                    </article>
                    <article class="coverage-card coming-soon">
                        <h3>📍 Santa Cruz</h3>
                        <p>Próxima expansión</p>
                        <span class="badge">Próximamente</span>
                    </article>
                    <article class="coverage-card coming-soon">
                        <h3>📍 Sucre</h3>
                        <p>Próxima expansión</p>
                        <span class="badge">Próximamente</span>
                    </article>
                    <article class="coverage-card coming-soon">
                        <h3>📍 Todo Bolivia</h3>
                        <p>Próxima expansión</p>
                        <span class="badge">Próximamente</span>
                    </article>
                </div>
            </div>
        </section>

        <!-- Contact Section -->
        <section id="contacto" class="contact" aria-labelledby="contact-title">
            <div class="container">
                <h2 id="contact-title" class="section-title">Contáctanos</h2>
                <div class="contact-grid">
                    <div class="contact-info">
                        <h3>Información de Contacto</h3>
                        
                        <div class="contact-detail">
                            <div class="contact-icon">📱</div>
                            <div class="contact-text">
                                <strong>WhatsApp / Teléfono</strong>
                                <a href="https://wa.me/59178491525">+591 78491525</a>
                            </div>
                        </div>

                        <div class="contact-detail">
                            <div class="contact-icon">✉️</div>
                            <div class="contact-text">
                                <strong>Email</strong>
                                <a href="mailto:contacto@domivolt.com.bo">contacto@domivolt.com.bo</a>
                                <a href="mailto:medi.orop.casi@gmail.com">medi.orop.casi@gmail.com</a>
                            </div>
                        </div>

                        <div class="contact-detail">
                            <div class="contact-icon">📍</div>
                            <div class="contact-text">
                                <strong>Dirección</strong>
                                Av. René Barrientos<br>
                                Barrio José Barbero<br>
                                Calle San Mauro<br>
                                Monteagudo, Chuquisaca - Bolivia
                            </div>
                        </div>

                        <div class="contact-detail">
                            <div class="contact-icon">🕐</div>
                            <div class="contact-text">
                                <strong>Horarios</strong>
                                Emergencias: 24/7<br>
                                Instalaciones: Lun - Vie
                            </div>
                        </div>
                    </div>

                    <div class="contact-form">
                        <h3 style="color: var(--primary); margin-bottom: 20px;">Solicita tu Presupuesto</h3>
                        <form id="contactForm">
                            <div class="form-group">
                                <label for="nombre">Nombre Completo *</label>
                                <input type="text" id="nombre" name="nombre" required placeholder="Tu nombre">
                            </div>

                            <div class="form-group">
                                <label for="telefono">Teléfono / WhatsApp *</label>
                                <input type="tel" id="telefono" name="telefono" required placeholder="Ej: 78491525">
                            </div>

                            <div class="form-group">
                                <label for="servicio">Tipo de Servicio *</label>
                                <select id="servicio" name="servicio" required>
                                    <option value="">Selecciona un servicio</option>
                                    <option value="emergencia">🚨 Emergencia 24/7</option>
                                    <option value="instalacion">🔌 Instalación Nueva</option>
                                    <option value="reparacion">🔧 Reparación</option>
                                    <option value="mantenimiento">⚙️ Mantenimiento</option>
                                    <option value="otro">💼 Otro</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label for="descripcion">Describe tu Necesidad</label>
                                <textarea id="descripcion" name="descripcion" placeholder="Cuéntanos qué necesitas..."></textarea>
                            </div>

                            <button type="submit" class="btn btn-primary" style="width: 100%;">
                                Enviar Solicitud
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <Footer />
</Layout>

<style>
    main {
        padding-top: 65px;
    }

    /* Hero Section */
    .hero {
        background: linear-gradient(135deg, var(--secondary) 0%, var(--primary) 100%);
        color: white;
        padding: 80px 20px; 
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .hero::before {
        content: '⚡';
        position: absolute;
        font-size: 300px;
        opacity: 0.05;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }

    .hero-content {
        max-width: 1200px;
        margin: 0 auto;
        position: relative;
        z-index: 1;
    }

    .hero h1 {
        font-size: 3.5rem;
        margin-bottom: 20px;
        color: var(--accent-light);
        text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
    }

    .hero p {
        font-size: 1.3rem;
        margin-bottom: 30px;
        color: var(--text-light);
    }

    .cta-buttons {
        display: flex;
        gap: 20px;
        justify-content: center;
        flex-wrap: wrap;
    }

    /* Services Section */
    .services {
        padding: 80px 20px;
        background: var(--bg-light);
    }

    .services-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 30px;
    }

    .service-card {
        background: white;
        padding: 30px;
        border-radius: 15px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        transition: all 0.3s ease;
        border-top: 4px solid var(--accent);
    }

    .service-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.15);
    }

    .service-icon {
        font-size: 3rem;
        margin-bottom: 20px;
        color: var(--accent);
    }

    .service-card h3 {
        color: var(--primary);
        font-size: 1.5rem;
        margin-bottom: 15px;
    }

    .service-card p {
        color: #666;
        margin-bottom: 10px;
    }

    .service-list {
        color: #666;
        margin: 15px 0 15px 20px;
    }

    .service-schedule {
        display: inline-block;
        background: var(--accent-light);
        color: var(--primary);
        padding: 5px 15px;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: bold;
        margin-top: 10px;
    }

    /* Coverage Section */
    .coverage {
        padding: 80px 20px;
        background: white;
    }

    .coverage-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 30px;
        margin-top: 40px;
    }

    .coverage-card {
        background: linear-gradient(135deg, var(--secondary) 0%, var(--primary) 100%);
        color: white;
        padding: 30px;
        border-radius: 15px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .coverage-card.active {
        background: linear-gradient(135deg, var(--accent) 0%, #FFBA42 100%);
        color: var(--primary);
    }

    .coverage-card.coming-soon {
        opacity: 0.7;
    }

    .coverage-card h3 {
        font-size: 1.8rem;
        margin-bottom: 10px;
    }

    .badge {
        display: inline-block;
        background: rgba(255,255,255,0.3);
        padding: 5px 15px;
        border-radius: 20px;
        font-size: 0.85rem;
        margin-top: 10px;
    }

    .coverage-card.active .badge {
        background: rgba(1, 60, 88, 0.2);
    }

    /* Why Choose Us Section (Aside) */
    .why-choose {
        padding: 80px 20px;
        background: linear-gradient(135deg, var(--text-light) 0%, var(--accent-light) 100%);
    }

    .why-choose h2 {
        text-align: center;
        font-size: 2.5rem;
        color: var(--primary);
        margin-bottom: 50px;
    }

    .benefits-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 30px;
    }

    .benefit-item {
        background: white;
        padding: 25px;
        border-radius: 15px;
        text-align: center;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }

    .benefit-icon {
        font-size: 3rem;
        margin-bottom: 15px;
    }

    .benefit-item h3 {
        color: var(--primary);
        margin-bottom: 10px;
    }

    .benefit-item p {
        color: #666;
    }

    /* Contact Section */
    .contact {
        padding: 80px 6px;
        background: var(--bg-light);
    }

    .contact-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 40px;
        margin-top: 40px;
    }

    .contact-info {
        background: white;
        padding: 20px;
        border-radius: 15px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }

    .contact-info h3 {
        color: var(--primary);
        margin-bottom: 20px;
        font-size: 1.5rem;
    }

    .contact-detail {
        display: flex;
        align-items: flex-start;
        gap: 15px;
        margin-bottom: 20px;
        padding: 8px;
        background: var(--bg-light);
        border-radius: 10px;
        transition: all 0.3s ease;
    }

    .contact-detail:hover {
        background: var(--text-light);
        transform: translateX(5px);
    }

    .contact-icon {
        font-size: 1.5rem;
        color: var(--accent);
        min-width: 30px;
    }

    .contact-text {
        flex: 1;
    }

    .contact-text strong {
        color: var(--primary);
        display: block;
        margin-bottom: 5px;
    }

    .contact-text a {
        color: var(--secondary);
        text-decoration: none;
    }

    .contact-text a:hover {
        color: var(--accent);
    }

    /* Contact Form */
    .contact-form {
        background: white;
        padding: 20px;
        border-radius: 15px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        color: var(--primary);
        font-weight: bold;
        margin-bottom: 8px;
    }

    .form-group input,
    .form-group textarea,
    .form-group select {
        width: 100%;
        padding: 12px;
        border: 2px solid #e0e0e0;
        border-radius: 8px;
        font-size: 1rem;
        transition: all 0.3s ease;
    }

    .form-group input:focus,
    .form-group textarea:focus,
    .form-group select:focus {
        outline: none;
        border-color: var(--accent);
        box-shadow: 0 0 0 3px rgba(245, 162, 1, 0.1);
    }

    .form-group textarea {
        resize: vertical;
        min-height: 120px;
    }

    @media (max-width: 768px) {
        .hero img {
            width: 250px;
            height: auto;
        }
        .hero h1 {
            font-size: 2.5rem;
        }
        .hero p {
            font-size: 1.1rem;
        }
        .contact-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 480px) {
        .hero img {
            width: 200px;
            height: auto;
        }
        .hero h1 {
            font-size: 2rem;
        }
        .hero p {
            font-size: 1rem;
        }
    }
</style>