---
// src/pages/trayectoria.astro
import Layout from '../layouts/Layout.astro';
import perfil from '../assets/perfil.png';
import Footer from '../components/Footer.astro';
---

<Layout title="Casimiro Oropeza - Ceo DomiVolt">
  <header>
      <nav>
          <a href="/" class="logo">
           <img src="/logodomivolt.png" alt="DomiVolt Logo">
              DomiVolt</a>
  
          <button class="hamburger" aria-label="Menú de navegación">
              <div class="line"></div>
              <div class="line"></div>
              <div class="line"></div>
          </button>
          <ul class="nav-links">
              <li><a href="/">Inicio</a></li>
              <li><a href="/servicios">Servicios</a></li>
              <li><a href="/#contacto">Contacto</a></li>
          </ul>
      </nav>
  </header>

  <main class="trayectoria-container">
    
    <!-- Encabezado con identidad DomiVolt -->
    <section class="hero">
      <div class="brand-badge">TECNICO PRINCIPAL</div>
      <img src={perfil.src} alt="Casimiro Oropeza - CEO DomiVolt">
      <h1>Casimiro Oropeza Medina</h1>
      <p class="subtitle">Electricista Domiciliario | Formación en Ingeniería de Sistemas</p>
      <div class="divider"></div> 
    </section>

    <section class="timeline">
      <!-- Hito 1 -->
      <div class="checkpoint">
        <div class="content">
          <span class="tag">1989</span>
          <h3>Raíces en Chuquisaca</h3>
          <p>Nacido en Uruguay (Prov. Hernando Siles). Mis inicios en este pueblo pequeño forjaron mi ética de trabajo y perseverancia.</p>
        </div>
      </div>

      <!-- Hito 2 -->
      <div class="checkpoint">
        <div class="content">
          <span class="tag">Formación</span>
          <h3>Monteagudo</h3>
          <p>Educación en la Escuela Raquel Loayza de Estrella y el Colegio Max Fernández Rojas. Aquí empezó mi interés por la técnica.</p>
        </div>
      </div>

      <!-- Hito 3: Resaltado con Azul DomiVolt -->
      <div class="checkpoint featured">
        <div class="content">
          <span class="tag light">UDABOL Santa Cruz</span>
          <h3>Ingeniería de Sistemas</h3>
          <p>La base lógica y tecnológica de mi trabajo. Aunque los desafíos económicos pausaron mis estudios, la visión de ingeniería define la calidad de DomiVolt hoy.</p>
        </div>
      </div>

      <!-- Hito 4 -->
      <div class="checkpoint">
        <div class="content">
          <span class="tag">Experiencia</span>
          <h3>TV Cable Monteagudo</h3>
          <p>Mis primeros pasos en instalaciones domiciliarias, aprendiendo a resolver problemas tecnicos reales bajo presión.</p>
        </div>
      </div>

      <!-- Hito 5: Trabajo Actual -->
      <div class="checkpoint present">
        <div class="content">
          <span class="tag orange">Actualmente</span>
          <h3>STS Bolivia Ltda.</h3>
          <p>Especialización en estándares industriales y de seguridad, conocimientos que traslado directamente a cada hogar que visito.</p>
        </div>
      </div>
    </section>

    <!-- Llamada a la acción -->
    <div class="cta-box">
      <h2>¿Necesitas un técnico confiable?</h2>
      <p>Llevo la experiencia de las grandes empresas a la comodidad de tu hogar.</p>
      <a href="https://wa.me/59167671818?text=Hola%20Casimiro,%20vi%20tu%20trayectoria%20y%20quisiera%20contratarte" class="btn-whatsapp" target="_blank">
        Agendar Servicio DomiVolt
      </a>
    </div>

  </main>
  <Footer />

  <script>
      document.addEventListener('DOMContentLoaded', () => {
          const hamburger = document.querySelector('.hamburger');
          const navLinks = document.querySelector('.nav-links');
          
          if(hamburger && navLinks) {
              hamburger.addEventListener('click', () => {
                  navLinks.classList.toggle('open');
                  hamburger.classList.toggle('toggle');
              });
          }
      });
  </script>
</Layout>

<style is:global>
  /* Paleta DomiVolt */
  :root {
    --orange-primary: #F5A201;
    --orange-light: #FFBA42;
    --orange-soft: #FFD35B;
    --blue-dark: #013C58;
    --blue-medium: #00537A;
    --blue-sky: #A8E8F9;
    --white: #ffffff;
  }
</style>

<style>
  /* Fondo general de la página con efecto de cuadrícula técnica */
  :global(body) {
    background-color: #050b14;
    background-image: linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 40px 40px;
  }

  .trayectoria-container {
    max-width: 850px;
    margin: 0 auto;
    padding: 120px 20px 60px; /* Aumentado para que el header fijo no tape el título */
    font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    line-height: 1.6;
    background: rgba(1, 60, 88, 0.6); /* Fondo semitransparente azulado */
    backdrop-filter: blur(10px); /* Efecto vidrio */
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 0 50px rgba(0,0,0,0.5);
  }

  .brand-badge {
    color: var(--orange-primary);
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .hero { 
    text-align: center; 
    margin-bottom: 60px; 
 }
  h1 { color: var(--white); font-size: 2.8rem; margin: 0; text-shadow: 0 0 20px rgba(1, 60, 88, 0.8); }
  .subtitle { color: var(--blue-sky); font-size: 1.1rem; font-weight: 500; }
  .divider { height: 5px; width: 80px; background: var(--orange-primary); margin: 25px auto; border-radius: 10px; }

  .hero img {
    width: 120px;
    border-radius: 50%;
    object-fit: cover;
  }
  /* Timeline */
  .timeline {
    border-left: 4px solid var(--orange-primary);
    margin-left: 30px;
    padding-left: 40px;
    position: relative;
  }

  .checkpoint { position: relative; margin-bottom: 50px; }
  
  /* Círculo de la línea de tiempo */
  .checkpoint::before {
    content: "";
    position: absolute;
    left: -49px;
    top: 5px;
    width: 14px;
    height: 14px;
    background: var(--blue-dark);
    border: 4px solid var(--orange-primary);
    border-radius: 50%;
    z-index: 2;
  }

  .tag {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--blue-dark);
    background: var(--blue-sky);
    padding: 4px 12px;
    border-radius: 20px;
    text-transform: uppercase;
  }

  .tag.orange { background: var(--orange-primary); color: white; }
  .tag.light { background: var(--orange-soft); color: var(--blue-dark); }

  h3 { color: var(--white); font-size: 1.5rem; margin: 10px 0 5px 0; }
  p { color: #d1d5db; margin: 0; }

  /* Estilo para el hito destacado (UDABOL) */
  .featured {
    background: rgba(0, 0, 0, 0.3);
    padding: 25px;
    border-radius: 15px;
    color: white;
    border: 1px solid var(--orange-primary);
  }
  .featured h3 { color: var(--orange-soft); }
  .featured p { color: #e2e8f0; }

  /* CTA */
  .cta-box {
    margin-top: 80px;
    background: linear-gradient(135deg, var(--blue-dark) 0%, var(--blue-medium) 100%);
    padding: 40px;
    border-radius: 20px;
    text-align: center;
    color: white;
    box-shadow: 0 10px 25px rgba(1, 60, 88, 0.2);
  }
  .cta-box p { 
    color: skyblue;
  }
  .btn-whatsapp {
    display: inline-block;
    background: var(--orange-primary);
    color: var(--blue-dark);
    padding: 15px 35px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 700;
    margin-top: 20px;
    transition: transform 0.3s ease;
  }

  .btn-whatsapp:hover {
    transform: scale(1.05);
    background: var(--orange-light);
  }

  @media (max-width: 600px) {
    h1 { font-size: 2rem; }
    .timeline { margin-left: 0; padding-left: 20px; }
    .checkpoint::before { left: -29px; } /* Ajustado para el nuevo padding */
    .featured { padding: 20px; }
    .cta-box { padding: 30px 20px; }
  }

  /* Estilos del Header (Estandarizados) */
  header { background: linear-gradient(135deg, var(--blue-dark) 0%, #000000 100%); padding: 20px 0; position: fixed; width: 100%; top: 0; z-index: 1000; box-shadow: 0 4px 20px rgba(252, 163, 17, 0.2); }
  nav { max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; padding: 0 20px; }
  .logo { display: flex; align-items: center; font-size: 28px; font-weight: bold; color: var(--orange-primary); text-decoration: none; text-shadow: 0 0 20px rgba(245, 162, 1, 0.5); }
  .logo img { width: 80px; }
  .nav-links { display: flex; gap: 30px; list-style: none; }
  .nav-links a { color: #E5E5E5; text-decoration: none; font-weight: 500; }
  .nav-links a:hover { color: var(--orange-primary); }
  .hamburger { display: none; cursor: pointer; background: none; border: none; padding: 10px; }
  .line { width: 25px; height: 3px; background-color: #E5E5E5; margin: 5px; transition: all 0.3s; }

  @media (max-width: 768px) {
      .hamburger { display: block; z-index: 1001; }
      .nav-links { position: fixed; background: #000000; height: 100vh; width: 100%; top: 0; left: 0; flex-direction: column; align-items: center; justify-content: center; transform: translateX(100%); transition: transform 0.3s ease-in-out; z-index: 1000; }
      .nav-links.open { transform: translateX(0%); }
      
      /* Animación Hamburguesa */
      .hamburger.toggle .line:nth-child(1) { transform: rotate(-45deg) translate(-5px, 6px); }
      .hamburger.toggle .line:nth-child(2) { opacity: 0; }
      .hamburger.toggle .line:nth-child(3) { transform: rotate(45deg) translate(-5px, -6px); }
  }
</style>
