---
// src/pages/trayectoria.astro
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import perfil from '../assets/perfil.png';
---

<Layout title="Casimiro Oropeza - Trayectoria DomiVolt">
  <Navbar />
  <main class="trayectoria-container">
    
    <!-- Encabezado con identidad DomiVolt -->
    <section class="hero">
      <div class="brand-badge">TECNICO PRINCIPAL</div>
      <img src={perfil.src} alt="Casimiro Oropeza - CEO DomiVolt">
      <h1>Casimiro Oropeza Medina</h1>
      <p class="subtitle">Electricista Domiciliario | Formación en Ingeniería de Sistemas</p>
      <div class="divider"></div> 
    </section>

    <section class="timeline">
      <!-- Hito 1 -->
      <div class="checkpoint">
        <div class="content">
          <span class="tag">1989</span>
          <h3>Raíces en Chuquisaca</h3>
          <p>Nacido en Uruguay (Prov. Hernando Siles). Mis inicios en este pueblo pequeño forjaron mi ética de trabajo y perseverancia.</p>
        </div>
      </div>

      <!-- Hito 2 -->
      <div class="checkpoint">
        <div class="content">
          <span class="tag">Formación</span>
          <h3>Monteagudo</h3>
          <p>Educación en la Escuela Raquel Loayza de Estrella y el Colegio Max Fernández Rojas. Aquí empezó mi interés por la técnica.</p>
        </div>
      </div>

      <!-- Hito 3: Resaltado con Azul DomiVolt -->
      <div class="checkpoint featured">
        <div class="content">
          <span class="tag light">UDABOL Santa Cruz</span>
          <h3>Ingeniería de Sistemas</h3>
          <p>La base lógica y tecnológica de mi trabajo. Aunque los desafíos económicos pausaron mis estudios, la visión de ingeniería define la calidad de DomiVolt hoy.</p>
        </div>
      </div>

      <!-- Hito 4 -->
      <div class="checkpoint">
        <div class="content">
          <span class="tag">Experiencia</span>
          <h3>TV Cable Monteagudo</h3>
          <p>Mis primeros pasos en instalaciones domiciliarias, aprendiendo a resolver problemas tecnicos reales bajo presión.</p>
        </div>
      </div>

      <!-- Hito 5: Trabajo Actual -->
      <div class="checkpoint present">
        <div class="content">
          <span class="tag orange">Actualmente</span>
          <h3>STS Bolivia Ltda.</h3>
          <p>Especialización en estándares industriales y de seguridad, conocimientos que traslado directamente a cada hogar que visito.</p>
        </div>
      </div>
    </section>

    <!-- Llamada a la acción -->
    <div class="cta-box">
      <h2>¿Necesitas un técnico confiable?</h2>
      <p>Llevo la experiencia de las grandes empresas a la comodidad de tu hogar.</p>
      <a href="https://wa.me/59167671818?text=Hola%20Casimiro,%20vi%20tu%20trayectoria%20y%20quisiera%20contratarte" class="btn-whatsapp" target="_blank">
        Agendar Servicio DomiVolt
      </a>
    </div>

  </main>
  <footer>
    <p>&copy; 2025 DomiVolt. Todos los derechos reservados.</p>
  </footer>
</Layout>

<style is:global>
  /* Paleta DomiVolt */
  :root {
    --orange-primary: #F5A201;
    --orange-light: #FFBA42;
    --orange-soft: #FFD35B;
    --blue-dark: #013C58;
    --blue-medium: #00537A;
    --blue-sky: #A8E8F9;
    --white: #ffffff;
  }
</style>

<style>
  /* Fondo general de la página con efecto de cuadrícula técnica */
  :global(body) {
    background-color: #050b14;
    background-image: linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 40px 40px;
  }

  .trayectoria-container {
    max-width: 850px;
    margin: 0 auto;
    padding: 60px 20px;
    font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    line-height: 1.6;
    background: rgba(1, 60, 88, 0.6); /* Fondo semitransparente azulado */
    backdrop-filter: blur(10px); /* Efecto vidrio */
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 0 50px rgba(0,0,0,0.5);
  }

  .brand-badge {
    color: var(--orange-primary);
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .hero { 
    text-align: center; 
    margin-bottom: 60px; 
 }
  h1 { color: var(--white); font-size: 2.8rem; margin: 0; text-shadow: 0 0 20px rgba(1, 60, 88, 0.8); }
  .subtitle { color: var(--blue-sky); font-size: 1.1rem; font-weight: 500; }
  .divider { height: 5px; width: 80px; background: var(--orange-primary); margin: 25px auto; border-radius: 10px; }

  .hero img {
    width: 120px;
    border-radius: 50%;
    object-fit: cover;
  }
  /* Timeline */
  .timeline {
    border-left: 4px solid var(--orange-primary);
    margin-left: 30px;
    padding-left: 40px;
    position: relative;
  }

  .checkpoint { position: relative; margin-bottom: 50px; }
  
  /* Círculo de la línea de tiempo */
  .checkpoint::before {
    content: "";
    position: absolute;
    left: -49px;
    top: 5px;
    width: 14px;
    height: 14px;
    background: var(--blue-dark);
    border: 4px solid var(--orange-primary);
    border-radius: 50%;
    z-index: 2;
  }

  .tag {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--blue-dark);
    background: var(--blue-sky);
    padding: 4px 12px;
    border-radius: 20px;
    text-transform: uppercase;
  }

  .tag.orange { background: var(--orange-primary); color: white; }
  .tag.light { background: var(--orange-soft); color: var(--blue-dark); }

  h3 { color: var(--white); font-size: 1.5rem; margin: 10px 0 5px 0; }
  p { color: #d1d5db; margin: 0; }

  /* Estilo para el hito destacado (UDABOL) */
  .featured {
    background: rgba(0, 0, 0, 0.3);
    padding: 25px;
    border-radius: 15px;
    color: white;
    border: 1px solid var(--orange-primary);
  }
  .featured h3 { color: var(--orange-soft); }
  .featured p { color: #e2e8f0; }

  /* CTA */
  .cta-box {
    margin-top: 80px;
    background: linear-gradient(135deg, var(--blue-dark) 0%, var(--blue-medium) 100%);
    padding: 40px;
    border-radius: 20px;
    text-align: center;
    color: white;
    box-shadow: 0 10px 25px rgba(1, 60, 88, 0.2);
  }
  .cta-box p { 
    color: skyblue;
  }
  .btn-whatsapp {
    display: inline-block;
    background: var(--orange-primary);
    color: var(--blue-dark);
    padding: 15px 35px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 700;
    margin-top: 20px;
    transition: transform 0.3s ease;
  }

  .btn-whatsapp:hover {
    transform: scale(1.05);
    background: var(--orange-light);
  }

  @media (max-width: 600px) {
    h1 { font-size: 2rem; }
    .timeline { margin-left: 10px; padding-left: 25px; }
    .checkpoint::before { left: -34px; }
  }

  footer {
    background: var(--blue-dark);
    color: var(--white);
    text-align: center;
    padding: 20px;
    margin-top: 0;
  }
</style>
