---
// src/pages/tecnicos.astro
import Layout from '../layouts/Layout.astro';
import perfil from '../assets/perfil.png';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';

// 1. Base de datos de técnicos (Centralizada para fácil edición)
const tecnicos = [
  {
    nombre: "Casimiro Oropeza Medina",
    cargo: "CEO & Técnico Principal",
    ciudad: "Monteagudo",
    especialidad: "Ingeniería de Sistemas & Redes de Fibra Óptica",
    foto: perfil, // Usamos el objeto de imagen para optimización
    whatsapp: "59167671818",
    rol: "Líder de Ingeniería & Fundador",
    experiencia: "15+ Años",
    proyectos: "1,200+ Éxitos",
    destacado: true
  },
  {
    nombre: "Miguel Angel Oropeza Medina", // Reemplaza con su nombre real
    cargo: "Socio & Técnico de Apoyo",
    ciudad: "Monteagudo",
    especialidad: "Instalaciones & Mantenimiento Local",
    foto: "/logodomivolt.png", 
    whatsapp: "59167671818",
    rol: "Socio & Especialista Técnico",
    destacado: false
  },
];

// REEMPLAZA ESTOS DATOS con tu trayectoria original
const trayectoria = [
  {
    anio: "2010",
    titulo: "Raíces y Formación",
    descripcion: "Originario de Urugual. Cursé estudios en Monteagudo y posteriormente Ingeniería de Sistemas en la UDABOL, Santa Cruz, sentando las bases de mi rigor técnico.",
    color: "orange"
  },
  {
    anio: "2013",
    titulo: "Experiencia Técnica en Monteagudo",
    descripcion: "Durante 2 años en TV Cable Monteagudo, desarrollé mis habilidades en electricidad domiciliaria y ejecuté ampliaciones de la red de televisión por cable coaxial.",
    color: "light"
  },
  {
    anio: "2015",
    titulo: "Liderazgo en Telecomunicaciones",
    descripcion: "Dediqué 9 años a STS Bolivia (Tigo) como experto en mantenimiento de fibra óptica de larga distancia, consolidando mi rigor técnico en infraestructuras críticas.",
    color: "light"
  },
  {
    anio: "2024",
    titulo: "Fundación de DomiVolt",
    descripcion: "En abril decidí emprender, volcando toda mi experiencia en sistemas complejos y precisión industrial para fundar DomiVolt.",
    color: "light"
  },
  {
    anio: "Actualidad",
    titulo: "Especialización FTTH - Entel",
    descripcion: "Actualmente desempeño funciones para Entel realizando nuevas instalaciones de FTTH, llevando la tecnología de internet por fibra óptica a más hogares.",
    color: "orange"
  }
];

const marcas = []; // Lista vacía por ahora para no mostrar placeholders
---

<Layout title="Equipo y Trayectoria Profesional | DomiVolt">
  <Header />
  <main class="experts-page-container">
    
    <section class="hero">
      <div class="brand-badge">RED NACIONAL DOMIVOLT</div>
      <h1>Liderazgo y <span class="highlight">Respaldo Técnico</span></h1>
      <p class="subtitle">Bajo la dirección del Ing. Casimiro Oropeza, garantizamos precisión en cada servicio.</p>
      <div class="divider"></div>
    </section>

    <!-- 2. Sección de Liderazgo (CEO) -->
    <section class="leader-section">
      {tecnicos.filter(t => t.destacado).map((ceo) => (
        <div class="ceo-card">
          <div class="ceo-image">
            <Image src={ceo.foto} alt={ceo.nombre} width={600} height={600} loading="eager" />
          </div>
          <div class="ceo-content">
            <span class="ceo-role-badge">{ceo.rol}</span>
            <span class="ciudad-tag">📍 Sede Central: {ceo.ciudad}</span>
            <h3>{ceo.nombre}</h3>
            <p class="cargo-principal">{ceo.cargo}</p>
            <p class="especialidad-principal">{ceo.especialidad}</p>
            <div class="trust-badges">
              <div class="badge-item"><span>{ceo.experiencia}</span> Experiencia</div>
              <div class="badge-item"><span>{ceo.proyectos}</span> Servicios</div>
            </div>
            <div class="ceo-actions">
              <a href={`https://wa.me/${ceo.whatsapp}`} class="btn-whatsapp">
                Consultoría Directa con el CEO
              </a>
            </div>
          </div>
        </div>
      ))}
    </section>

    <!-- 3. Red de Apoyo (Secundarios) -->
    {tecnicos.filter(t => !t.destacado).length > 0 && (
      <section class="support-network">
        <h2 class="section-title">Nuestro Equipo en <span class="highlight">Monteagudo</span></h2>
        <div class="secondary-grid">
          {tecnicos.filter(t => !t.destacado).map((tecnico) => (
            <div class="tecnico-card-small">
              <div class="tecnico-header-small">
                <img src={tecnico.foto} alt={tecnico.nombre} class="avatar-mini" />
                <div class="card-info-small">
                  <span class="rol-tag-mini">{tecnico.rol}</span>
                  <h3>{tecnico.nombre}</h3>
                  <span class="ciudad-tag-small">📍 {tecnico.ciudad}</span>
                </div>
              </div>
              <div class="card-body-small">
                  <p class="especialidad-small">{tecnico.especialidad}</p>
                  <div class="card-footer-small">
                    <span class="status-badge">Socio Activo</span>
                    <a href={`https://wa.me/${tecnico.whatsapp}?text=Hola%20${tecnico.nombre},%20vengo%20desde%20la%20web%20de%20DomiVolt`} class="btn-whatsapp-mini">
                      Contactar
                    </a>
                  </div>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Sección de Trayectoria del CEO -->
    <section class="founder-bio">
      <div class="bio-header">
        <span class="brand-badge">Autoridad Técnica</span>
        <h2>Mi Compromiso con la <span class="highlight">Excelencia</span></h2>
      </div>
      <ul class="timeline">
        {trayectoria.map(item => (
          <li class="checkpoint">
            <span class={`year-tag ${item.color}`}>{item.anio}</span>
            <h3>{item.titulo}</h3>
            <p>{item.descripcion}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- 3.5 Sección de Testimonio Destacado (Opcional pero recomendado) -->
    <section class="testimonial-short">
      <div class="testimonial-card">
        <p class="quote">"La precisión y seguridad que Casimiro aportó a nuestra planta industrial superó nuestras expectativas. Es nuestro técnico de confianza."</p>
        <div class="quote-author">
          <div class="author-info">
            <strong>Ing. Roberto Méndez</strong>
            <span>Gerente de Operaciones - Santa Cruz</span>
          </div>
        </div>
      </div>
    </section>

    {marcas.length > 0 && (
      <section class="brands-section">
        <h2 class="section-title">Empresas que <span class="highlight">Confían en DomiVolt</span></h2>
        <div class="brands-container">
          {marcas.map(marca => (
            <div class="brand-logo">
              <img src={marca.logo} alt={marca.nombre} title={marca.nombre} />
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Llamada a la acción -->
    <div class="cta-box">
      <h2>¿Necesitas un técnico confiable?</h2>
      <p>Llevo la precisión de la ingeniería y la experiencia industrial a la seguridad de tu hogar.</p>
      <a href={`https://wa.me/59167671818?text=Hola%20Casimiro,%20necesito%20una%20visita%20técnica%20especializada%20de%20DomiVolt`} class="btn-whatsapp" target="_blank" rel="noopener noreferrer">
        Solicitar Visita Técnica Ahora
      </a>
    </div>

  </main>
  <Footer />

</Layout>

<style>
  /* Fondo general de la página con efecto de cuadrícula técnica */
  /* Nota: Usamos var(--primary) para consistencia con index */
  :global(body) {
    background-color: #000;
    background-image: linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 40px 40px;
  }

  .experts-page-container {
    max-width: 1000px; /* Un poco más ancho para el equipo */
    margin: 0 auto;
    padding: 120px 20px 60px; /* Aumentado para que el header fijo no tape el título */
    font-family: var(--md-font-sans);
    line-height: 1.6;
    background: color-mix(in srgb, var(--primary) 70%, transparent);
    backdrop-filter: blur(10px); /* Efecto vidrio */
    border-radius: var(--shape-xl);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 0 50px rgba(0,0,0,0.5);
  }

  .brand-badge {
    color: var(--accent);
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 10px;
    font-size: 0.8rem;
  }

  .hero { 
    text-align: center; 
    margin-bottom: 60px; 
 }
  h1 { color: var(--white); font-size: 2.8rem; margin: 0; text-shadow: 0 0 20px rgba(1, 60, 88, 0.8); }
  .highlight { color: var(--accent); }
  .subtitle { color: #A8E8F9; font-size: 1.1rem; font-weight: 500; }
  .divider { height: 5px; width: 80px; background: var(--accent); margin: 25px auto; border-radius: 10px; }
  
  /* Timeline / Biografía Styles */
  .founder-bio {
    margin-top: 100px;
    padding-top: 40px;
  }
  .bio-header { text-align: center; margin-bottom: 50px; }
  .bio-header h2 { font-size: 2.2rem; color: #fff; margin: 10px 0; }
  
  .timeline {
    border-left: 1px solid rgba(252, 163, 17, 0.3);
    margin: 0 auto;
    max-width: 800px;
    padding-left: 40px;
    position: relative;
    list-style: none;
  }

  .checkpoint {
    position: relative;
    margin-bottom: 40px;
    background: rgba(255, 255, 255, 0.02);
    padding: 15px 25px;
    border-radius: 12px;
    transition: background 0.3s ease;
  }

  .checkpoint::before {
    content: "";
    position: absolute;
    left: -44.5px;
    top: 20px;
    width: 8px;
    height: 8px;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
    border-radius: 50%;
  }

  .year-tag {
    font-size: 0.7rem;
    font-weight: 800;
    background: #A8E8F9;
    color: #000;
    padding: 3px 10px;
    border-radius: 5px;
    text-transform: uppercase;
  }
  
  .year-tag.orange { background: var(--accent); }
  .year-tag.light { background: var(--accent-light); }

  .checkpoint h3 { color: var(--accent); margin: 10px 0; font-size: 1.3rem; }
  .checkpoint p { color: #ccc; font-size: 0.95rem; }

  /* Liderazgo / CEO Styles */
  .leader-section {
    margin-bottom: 80px;
    display: flex;
    justify-content: center;
  }

  .ceo-card {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    background: rgba(255, 255, 255, 0.05);
    border: 2px solid var(--accent);
    border-radius: 30px;
    padding: 40px;
    align-items: center;
    max-width: 900px;
    max-width: 1000px;
  }

  .ceo-image { position: relative; width: 100%; max-width: 300px; aspect-ratio: 1/1; margin: 0 auto; }
  .ceo-image img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; border: 4px solid var(--accent); background: rgba(255,255,255,0.05); }
  .ceo-image { position: relative; width: 100%; max-width: 380px; aspect-ratio: 1/1; margin: 0 auto; }
  .ceo-image img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; border: 4px solid var(--accent); background: rgba(255,255,255,0.05); box-shadow: 0 0 50px rgba(252, 163, 17, 0.25); }
  
  .ceo-content { flex: 1; min-width: 280px; }
  .ceo-content h3 { font-size: 2.2rem; color: #fff; margin: 10px 0; }
  .cargo-principal { color: var(--accent); font-size: 1.2rem; font-weight: bold; }
  .especialidad-principal { color: #A8E8F9; margin-bottom: 25px; }

  .trust-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 30px;
  }

  .badge-item {
    flex: 1;
    min-width: 120px;
    background: rgba(255, 255, 255, 0.1);
    padding: 10px 15px;
    border-radius: 12px;
    font-size: 0.8rem;
    color: #ccc;
    text-align: center;
  }

  .badge-item span { display: block; color: var(--accent); font-weight: 800; font-size: 1.1rem; }

  /* Red de Apoyo (Secundarios) */
  .support-network {
    margin-top: 60px;
    text-align: center;
  }

  .section-title { color: #fff; font-size: 1.8rem; margin-bottom: 40px; }

  .secondary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
    max-width: 800px;
    margin: 0 auto;
    justify-content: center;
  }

  .tecnico-card-small {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(252, 163, 17, 0.1);
    border-radius: 20px;
    padding: 25px;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .tecnico-card-small:hover {
    border-color: var(--accent-light);
    background: rgba(255, 255, 255, 0.06);
    transform: translateY(-5px);
  }

  .tecnico-header-small { display: flex; align-items: center; gap: 15px; margin-bottom: 20px; }
  .avatar-mini { width: 60px; height: 60px; border-radius: 50%; object-fit: cover; border: 2px solid var(--accent); background: rgba(255,255,255,0.1); }

  .card-info-small h3 { color: #fff; font-size: 1.2rem; margin: 5px 0; }
  .rol-tag-mini { font-size: 0.65rem; color: var(--accent); font-weight: 900; text-transform: uppercase; letter-spacing: 1px; }
  .ciudad-tag-small { font-size: 0.8rem; color: #A8E8F9; opacity: 0.8; }
  .especialidad-small { color: #ccc; font-size: 0.9rem; margin-bottom: 20px; min-height: 45px; }

  .card-footer-small {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: 15px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .status-badge {
    font-size: 0.7rem;
    background: rgba(0, 255, 0, 0.1);
    color: #4ade80;
    padding: 4px 10px;
    border-radius: 50px;
    border: 1px solid rgba(74, 222, 128, 0.2);
  }

  .btn-whatsapp-mini {
    display: inline-block;
    background: var(--accent);
    color: #000;
    padding: 6px 14px;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 800;
    text-decoration: none;
    transition: all 0.3s ease;
    border: 1px solid transparent;
  }

  .btn-whatsapp-mini:hover {
    transform: scale(1.05);
    box-shadow: 0 5px 15px rgba(252, 163, 17, 0.3);
  }

  .ceo-role-badge {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.35em;
    color: var(--accent);
    border: 1px solid rgba(252, 163, 17, 0.4);
    padding: 6px 16px;
    border-radius: 3px;
    margin-bottom: 18px;
    background: rgba(252, 163, 17, 0.03);
  }

  /* Sección de Marcas */
  .brands-section {
    margin-top: 80px;
    text-align: center;
    padding: 40px 0;
  }

  .brands-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 50px;
    align-items: center;
    margin-top: 30px;
  }

  .brand-logo img {
    max-width: 140px;
    height: auto;
    filter: grayscale(100%) opacity(0.5);
    transition: all 0.4s ease;
  }

  .brand-logo img:hover {
    filter: grayscale(0%) opacity(1);
    transform: translateY(-5px);
  }

  /* Testimonial Styles */
  .testimonial-short {
    max-width: 800px;
    margin: 60px auto;
    padding: 0 20px;
  }

  .testimonial-card {
    background: rgba(255, 255, 255, 0.03);
    border-left: 4px solid var(--accent);
    padding: 30px;
    border-radius: 0 20px 20px 0;
  }

  .quote {
    font-style: italic;
    font-size: 1.2rem;
    color: #eee;
    margin-bottom: 20px;
  }

 /* CTA */
 .cta-box {
    margin-top: 80px;
    padding: 40px;
    background: linear-gradient(135deg, rgba(252, 163, 17, 0.1) 0%, rgba(20, 33, 61, 0.8) 100%);
    border-radius: 20px;
    border: 1px solid var(--accent);
    text-align: center;
  }

  .cta-box h2 { color: #fff; margin-bottom: 15px; }
  .cta-box p { color: #ccc; margin-bottom: 30px; max-width: 600px; margin-left: auto; margin-right: auto; }

  .btn-whatsapp {
    display: inline-block;
    background: var(--accent);
    color: #000;
    padding: 15px 35px;
    border-radius: 50px;
    font-weight: 800;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 10px 20px rgba(252, 163, 17, 0.3);
  }

  .btn-whatsapp:hover {
    transform: scale(1.05);
    box-shadow: 0 15px 25px rgba(252, 163, 17, 0.4);
  }
</style>
